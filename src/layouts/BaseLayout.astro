---
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://nhlobo.github.io/testing';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const ogImageUrl = ogImage ? `${siteUrl}/${ogImage}` : `${siteUrl}/favicon.svg`;
const fullTitle = title.includes('Mapengo') ? title : `${title} | Mapengo Innovations`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "Mapengo Innovations",
      "url": siteUrl,
      "logo": `${siteUrl}/favicon.svg`,
      "description": "South African software development company specialising in web development, mobile apps, and business systems.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Johannesburg",
        "addressRegion": "Gauteng",
        "addressCountry": "ZA"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "hello@mapengoinnovations.co.za",
        "availableLanguage": ["English", "Zulu", "Sotho"]
      },
      "areaServed": "ZA",
      "sameAs": []
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Mapengo Innovations",
      "publisher": { "@id": `${siteUrl}/#organization` }
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      "url": canonical,
      "name": fullTitle,
      "description": description,
      "isPartOf": { "@id": `${siteUrl}/#website` }
    }
  ]
};
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Mapengo Innovations" />
    <meta property="og:locale" content="en_ZA" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@mapengotech" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <!-- PWA -->
    <link rel="manifest" href={`${base}manifest.json`} />
    <meta name="theme-color" content="#0A1628" />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <slot />

    <!-- WhatsApp Floating Button -->
    <a
      href="https://wa.me/27600000000?text=Hi%2C%20I%27d%20like%20to%20discuss%20a%20project%20with%20Mapengo%20Innovations."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat on WhatsApp"
      style="position:fixed;bottom:24px;right:24px;z-index:900;width:56px;height:56px;border-radius:50%;background:#25D366;color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(0,0,0,0.2);text-decoration:none;transition:transform .2s,box-shadow .2s;"
      onmouseover="this.style.transform='scale(1.1)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.28)';"
      onmouseout="this.style.transform='scale(1)';this.style.boxShadow='0 4px 16px rgba(0,0,0,0.2)';"
      data-analytics-cta="whatsapp-float"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="28" height="28" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        <path d="M12 0C5.373 0 0 5.373 0 12c0 2.125.555 4.122 1.528 5.857L.057 23.571l5.887-1.544A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.782 9.782 0 01-5.031-1.391l-.36-.214-3.734.979.996-3.648-.235-.374A9.79 9.79 0 012.18 12C2.18 6.58 6.58 2.18 12 2.18S21.818 6.58 21.818 12 17.42 21.818 12 21.818z"/>
      </svg>
    </a>

    <!-- Sticky CTA Bar -->
    <div
      id="sticky-cta-bar"
      style="position:fixed;bottom:0;left:0;right:0;z-index:800;background:var(--color-primary);color:var(--color-white);padding:12px var(--space-4);display:none;align-items:center;justify-content:center;gap:var(--space-3);box-shadow:0 -4px 16px rgba(0,0,0,0.15);"
      role="complementary"
      aria-label="Quick action bar"
    >
      <p style="font-size:.9rem;font-weight:600;margin:0;opacity:.9;" id="sticky-cta-text">Ready to grow your business?</p>
      <a
        href={`${base}contact/`}
        id="sticky-cta-btn"
        style="background:var(--color-accent);color:var(--color-white);padding:8px 20px;border-radius:var(--radius-full);font-weight:700;font-size:.875rem;text-decoration:none;white-space:nowrap;"
        data-analytics-cta="sticky-bar"
      >Get a Free Quote</a>
      <button
        onclick="document.getElementById('sticky-cta-bar').style.display='none';sessionStorage.setItem('mi_sticky_dismissed','1');"
        aria-label="Dismiss"
        style="background:none;border:none;color:rgba(255,255,255,.5);font-size:1.25rem;cursor:pointer;padding:0 0 0 var(--space-1);line-height:1;"
      >×</button>
    </div>

    <!-- Cookie Consent Banner -->
    <div
      id="cookie-banner"
      style="position:fixed;bottom:0;left:0;right:0;z-index:1000;background:var(--color-grey-800);color:var(--color-white);padding:var(--space-3) var(--space-4);display:none;box-shadow:0 -4px 24px rgba(0,0,0,0.2);"
      role="dialog"
      aria-modal="false"
      aria-label="Cookie consent"
    >
      <div style="max-width:var(--max-width);margin:0 auto;display:flex;gap:var(--space-3);align-items:flex-start;flex-wrap:wrap;">
        <div style="flex:1;min-width:240px;">
          <p style="font-size:.9rem;font-weight:700;color:var(--color-white);margin-bottom:6px;">🍪 We use cookies</p>
          <p style="font-size:.85rem;color:rgba(255,255,255,.75);line-height:1.5;margin:0;">We use cookies to personalise content, analyse site traffic, and improve your experience. By clicking "Accept All", you consent to our use of cookies in accordance with our <a href={`${base}legal/privacy/`} style="color:var(--color-teal);text-decoration:underline;">Privacy Policy</a> and <a href={`${base}legal/popia/`} style="color:var(--color-teal);text-decoration:underline;">POPIA Compliance</a> notice.</p>
        </div>
        <div style="display:flex;flex-direction:column;gap:var(--space-1);min-width:180px;">
          <div id="cookie-preferences" style="display:none;background:rgba(255,255,255,.06);padding:var(--space-2);border-radius:var(--radius-md);margin-bottom:var(--space-1);">
            <label style="display:flex;align-items:center;gap:8px;font-size:.8rem;margin-bottom:8px;cursor:pointer;">
              <input type="checkbox" id="pref-analytics" style="accent-color:var(--color-accent);" /> Analytics cookies
            </label>
            <label style="display:flex;align-items:center;gap:8px;font-size:.8rem;cursor:pointer;">
              <input type="checkbox" id="pref-personalization" style="accent-color:var(--color-accent);" /> Personalisation cookies
            </label>
          </div>
          <button
            onclick="window._miConsentAcceptAll()"
            style="background:var(--color-accent);color:var(--color-white);padding:9px 18px;border-radius:var(--radius-full);font-weight:700;font-size:.85rem;cursor:pointer;border:none;width:100%;"
          >Accept All</button>
          <button
            onclick="window._miConsentTogglePrefs()"
            id="prefs-toggle-btn"
            style="background:rgba(255,255,255,.1);color:var(--color-white);padding:8px 18px;border-radius:var(--radius-full);font-weight:600;font-size:.85rem;cursor:pointer;border:1px solid rgba(255,255,255,.2);width:100%;"
          >Manage Preferences</button>
          <button
            id="cookie-save-prefs-btn"
            onclick="window._miConsentSavePrefs()"
            style="display:none;background:var(--color-teal);color:var(--color-primary);padding:8px 18px;border-radius:var(--radius-full);font-weight:700;font-size:.85rem;cursor:pointer;border:none;width:100%;"
          >Save Preferences</button>
          <button
            onclick="window._miConsentRejectAll()"
            style="background:none;color:rgba(255,255,255,.5);padding:6px;font-size:.8rem;cursor:pointer;border:none;text-decoration:underline;"
          >Reject non-essential</button>
        </div>
      </div>
    </div>

    <!-- Smart CTA / Intelligence + Cookie Consent + Sticky CTA -->
    <script is:inline define:vars={{ base }}>
      (function () {
        var KEY = 'mi_intelligence';
        var CONSENT_KEY = 'mi_consent';

        // ── Consent helpers ──────────────────────────────────────────────
        function getConsent() {
          try { return JSON.parse(localStorage.getItem(CONSENT_KEY) || 'null'); } catch { return null; }
        }
        function setConsent(prefs) {
          try {
            localStorage.setItem(CONSENT_KEY, JSON.stringify(prefs));
            window.dispatchEvent(new CustomEvent('mi:consent-change', { detail: prefs }));
          } catch {}
        }

        // ── Session helpers ──────────────────────────────────────────────
        function loadSession() {
          try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; }
        }
        function computeIntent(d) {
          if (!d) return 'new';
          if (d.visits >= 4 || d.scrollDepth > 70 || (d.ctaClicks && d.ctaClicks.length > 2)) return 'high-intent';
          if (d.visits >= 2) return 'returning';
          return 'new';
        }

        // ── Update session on page load ──────────────────────────────────
        var consent = getConsent();
        if (consent && consent.personalization) {
          var data = loadSession() || { visits: 0, pageViews: [], ctaClicks: [], industryInterests: [], scrollDepth: 0, timeOnSite: 0, lastVisit: Date.now(), intent: 'new' };
          data.visits = (data.visits || 0) + 1;
          data.lastVisit = Date.now();
          data.intent = computeIntent(data);
          try { localStorage.setItem(KEY, JSON.stringify(data)); } catch {}
        }

        // ── Cookie consent public API ────────────────────────────────────
        window._miConsentAcceptAll = function () {
          setConsent({ analytics: true, personalization: true, marketing: false });
          hideBanner();
        };
        window._miConsentRejectAll = function () {
          setConsent({ analytics: false, personalization: false, marketing: false });
          hideBanner();
        };
        window._miConsentTogglePrefs = function () {
          var prefs = document.getElementById('cookie-preferences');
          var saveBtn = document.getElementById('cookie-save-prefs-btn');
          var toggleBtn = document.getElementById('prefs-toggle-btn');
          if (prefs) {
            var showing = prefs.style.display !== 'none';
            prefs.style.display = showing ? 'none' : 'block';
            if (saveBtn) saveBtn.style.display = showing ? 'none' : 'block';
            if (toggleBtn) toggleBtn.textContent = showing ? 'Manage Preferences' : 'Hide Preferences';
          }
        };
        window._miConsentSavePrefs = function () {
          var analytics = document.getElementById('pref-analytics');
          var personalization = document.getElementById('pref-personalization');
          setConsent({
            analytics: analytics ? analytics.checked : false,
            personalization: personalization ? personalization.checked : false,
            marketing: false,
          });
          hideBanner();
        };
        function hideBanner() {
          var banner = document.getElementById('cookie-banner');
          if (banner) banner.style.display = 'none';
        }

        // ── DOMContentLoaded logic ───────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
          var session = loadSession();
          var intent = computeIntent(session);

          // Smart CTAs
          var ctaMap = {
            'new': { text: 'Explore Our Solutions', href: base + 'services/' },
            'returning': { text: 'Get a Custom Quote', href: base + 'contact/' },
            'high-intent': { text: 'Start Your Project Today', href: base + 'contact/#form' }
          };
          var cta = ctaMap[intent] || ctaMap['new'];
          document.querySelectorAll('[data-smart-cta]').forEach(function (el) {
            el.textContent = cta.text;
            el.href = cta.href;
          });

          // Scroll depth tracking
          var liveConsent = getConsent();
          if (liveConsent && liveConsent.analytics) {
            window.addEventListener('scroll', function () {
              var scrollable = document.body.scrollHeight - window.innerHeight;
              if (scrollable <= 0) return;
              var depth = Math.round((window.scrollY / scrollable) * 100);
              var s = loadSession();
              if (s && depth > (s.scrollDepth || 0)) {
                s.scrollDepth = depth;
                s.intent = computeIntent(s);
                if (liveConsent.personalization) {
                  try { localStorage.setItem(KEY, JSON.stringify(s)); } catch {}
                }
              }
            }, { passive: true });
          }

          // Analytics CTA click tracking
          document.querySelectorAll('[data-analytics-cta]').forEach(function (el) {
            el.addEventListener('click', function () {
              var label = el.getAttribute('data-analytics-cta');
              try {
                var events = JSON.parse(localStorage.getItem('mi_analytics_events') || '[]');
                events.push({ type: 'cta_click', label: label, path: location.pathname, timestamp: Date.now() });
                localStorage.setItem('mi_analytics_events', JSON.stringify(events.slice(-500)));
              } catch {}
            });
          });

          // Cookie consent banner
          if (!getConsent()) {
            var banner = document.getElementById('cookie-banner');
            if (banner) {
              // Small delay so page renders first
              setTimeout(function () { banner.style.display = 'flex'; }, 800);
            }
          }

          // Sticky CTA bar — show after 40% scroll if not dismissed
          if (!sessionStorage.getItem('mi_sticky_dismissed')) {
            var stickyBar = document.getElementById('sticky-cta-bar');
            var stickyBtn = document.getElementById('sticky-cta-btn');
            var stickyText = document.getElementById('sticky-cta-text');
            if (stickyBar && stickyBtn) {
              // Update sticky CTA text based on intent
              var stickyTextMap = {
                'new': { text: 'Ready to grow your business?', btn: 'Explore Solutions', href: base + 'services/' },
                'returning': { text: 'Welcome back — let\'s continue.', btn: 'Get a Custom Quote', href: base + 'contact/' },
                'high-intent': { text: 'You\'re ready to start — let\'s talk.', btn: 'Start Your Project', href: base + 'contact/#form' }
              };
              var stickyData = stickyTextMap[intent] || stickyTextMap['new'];
              if (stickyText) stickyText.textContent = stickyData.text;
              stickyBtn.textContent = stickyData.btn;
              stickyBtn.href = stickyData.href;

              var shown = false;
              window.addEventListener('scroll', function () {
                var scrollable2 = document.body.scrollHeight - window.innerHeight;
                if (scrollable2 <= 0) return;
                var pct = (window.scrollY / scrollable2) * 100;
                if (!shown && pct > 40) {
                  shown = true;
                  stickyBar.style.display = 'flex';
                }
              }, { passive: true });
            }
          }
        });
      })();
    </script>

    <!-- Service Worker registration -->
    <script is:inline define:vars={{ swPath: base + 'sw.js' }}>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register(swPath).catch(function () {});
        });
      }
    </script>

  </body>
</html>
