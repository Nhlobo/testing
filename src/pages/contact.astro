  <script is:inline>
  (function () {
    'use strict';

    var MIN_DESC_CHARS = 50;

    var state = {
      step: 1,
      businessType: null,
      services: [],
      budget: null,
      timeline: null,
      fullName: '',
      businessName: '',
      email: '',
      phone: '',
      city: '',
      referral: '',
      description: ''
    };

    var typeLabels = {
      individual: 'Individual / Freelancer',
      startup: 'Startup (< R1M)',
      sme: 'SME (R1M–R10M)',
      enterprise: 'Enterprise (R10M+)',
      government: 'Government / NGO'
    };
    var serviceLabels = {
      web: 'Web Development',
      mobile: 'Mobile App',
      ecommerce: 'E-Commerce Store',
      erp: 'Business System / ERP',
      design: 'UI/UX Design',
      cloud: 'Cloud Infrastructure'
    };
    var budgetLabels = {
      'under15k': 'Under R15,000',
      '15k-50k': 'R15,000–R50,000',
      '50k-150k': 'R50,000–R150,000',
      '150k-500k': 'R150,000–R500,000',
      '500k+': 'R500,000+'
    };
    var timelineLabels = {
      asap: 'ASAP (2–4 weeks)',
      '1-3months': '1–3 Months',
      '3-6months': '3–6 Months',
      '6months+': '6+ Months'
    };
    var cityLabels = {
      johannesburg: 'Johannesburg',
      'cape-town': 'Cape Town',
      durban: 'Durban',
      pretoria: 'Pretoria',
      'port-elizabeth': 'Gqeberha (Port Elizabeth)',
      other: 'Other'
    };

    var estimates = {
      'under15k': { min: 8000, max: 15000, weeks: '2–4' },
      '15k-50k': { min: 15000, max: 50000, weeks: '4–10' },
      '50k-150k': { min: 50000, max: 150000, weeks: '8–16' },
      '150k-500k': { min: 150000, max: 500000, weeks: '16–32' },
      '500k+': { min: 500000, max: null, weeks: '32+' }
    };
    var serviceComplexity = { web: 1, design: 1.1, ecommerce: 1.3, mobile: 1.4, erp: 1.6, cloud: 1.2 };

    function formatZAR(n) {
      return 'R' + n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    function computeQuote() {
      if (!state.budget || state.services.length === 0) return null;
      var e = estimates[state.budget];
      var complexity = state.services.reduce(function(acc, s) {
        return acc + (serviceComplexity[s] || 1);
      }, 0) / state.services.length;
      var minVal = Math.round((e.min * complexity) / 1000) * 1000;
      var maxVal = e.max ? Math.round((e.max * complexity) / 1000) * 1000 : null;
      var serviceStr = state.services.map(function(s) { return serviceLabels[s]; }).join(', ');
      var rangeStr = maxVal ? (formatZAR(minVal) + '–' + formatZAR(maxVal)) : (formatZAR(minVal) + '+');
      return 'Based on ' + serviceStr + ' with a ' + (budgetLabels[state.budget] || '') + ' investment bracket, expect an investment of approximately ' + rangeStr + ' and a delivery timeline of ' + e.weeks + ' weeks. This is a preliminary estimate — your formal proposal will include a full itemised breakdown.';
    }

    function updateProgress(step) {
      var totalSteps = 5;
      var pct = step <= totalSteps ? ((step - 1) / (totalSteps - 1)) * 100 : 100;
      var line = document.getElementById('progress-line');
      if (line) line.style.width = pct + '%';
      for (var i = 1; i <= totalSteps; i++) {
        var dot = document.getElementById('dot-' + i);
        var lbl = document.getElementById('dot-label-' + i);
        if (!dot) continue;
        if (i < step) {
          dot.style.background = 'var(--color-teal)';
          dot.style.color = '#fff';
          dot.style.boxShadow = '0 2px 8px rgba(0,201,167,.35)';
          dot.innerHTML = '&#10003;';
          if (lbl) { lbl.style.color = 'var(--color-teal)'; lbl.style.fontWeight = '600'; }
        } else if (i === step) {
          dot.style.background = 'var(--color-accent)';
          dot.style.color = '#fff';
          dot.style.boxShadow = '0 2px 8px rgba(255,107,53,.4)';
          dot.innerHTML = String(i);
          if (lbl) { lbl.style.color = 'var(--color-accent)'; lbl.style.fontWeight = '700'; }
        } else {
          dot.style.background = 'var(--color-grey-200)';
          dot.style.color = 'var(--color-grey-600)';
          dot.style.boxShadow = 'none';
          dot.innerHTML = String(i);
          if (lbl) { lbl.style.color = 'var(--color-grey-600)'; lbl.style.fontWeight = '500'; }
        }
      }
    }

    window.goToStep = function(target) {
      if (target > state.step) {
        if (!validateStep(state.step)) return;
      }
      document.querySelectorAll('.form-step').forEach(function(el) { el.style.display = 'none'; });
      if (target === 5) populateSummary();
      var stepEl = document.getElementById('step-' + target);
      if (stepEl) stepEl.style.display = 'block';
      state.step = target;
      updateProgress(target);
      var formEl = document.getElementById('quote-form');
      if (formEl) formEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    function validateStep(step) {
      if (step === 1) {
        var err = document.getElementById('error-step1');
        if (!state.businessType) { if (err) err.style.display = 'block'; return false; }
        if (err) err.style.display = 'none';
      }
      if (step === 2) {
        var err2 = document.getElementById('error-step2');
        if (state.services.length === 0) { if (err2) err2.style.display = 'block'; return false; }
        if (err2) err2.style.display = 'none';
      }
      if (step === 3) {
        var err3 = document.getElementById('error-step3');
        if (!state.budget || !state.timeline) { if (err3) err3.style.display = 'block'; return false; }
        if (err3) err3.style.display = 'none';
      }
      if (step === 4) {
        var valid = true;
        var nameEl = document.getElementById('full-name');
        var bizEl = document.getElementById('business-name');
        var emailEl = document.getElementById('email-addr');
        var descEl = document.getElementById('description');
        var errName = document.getElementById('err-name');
        var errBiz = document.getElementById('err-business');
        var errEmail = document.getElementById('err-email');
        var errDesc = document.getElementById('err-desc');

        state.fullName = nameEl ? nameEl.value.trim() : '';
        state.businessName = bizEl ? bizEl.value.trim() : '';
        state.email = emailEl ? emailEl.value.trim() : '';
        state.phone = ((document.getElementById('phone') || {}).value || '').trim();
        state.city = (document.getElementById('city') || {}).value || '';
        state.referral = (document.getElementById('referral') || {}).value || '';
        state.description = descEl ? descEl.value.trim() : '';

        if (!state.fullName) {
          if (errName) errName.style.display = 'block';
          if (nameEl) nameEl.style.borderColor = '#C0410A';
          valid = false;
        } else {
          if (errName) errName.style.display = 'none';
          if (nameEl) nameEl.style.borderColor = 'var(--color-grey-200)';
        }
        var needsBiz = state.businessType !== 'individual';
        if (needsBiz && !state.businessName) {
          if (errBiz) errBiz.style.display = 'block';
          if (bizEl) bizEl.style.borderColor = '#C0410A';
          valid = false;
        } else {
          if (errBiz) errBiz.style.display = 'none';
          if (bizEl) bizEl.style.borderColor = 'var(--color-grey-200)';
        }
        var emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRe.test(state.email)) {
          if (errEmail) errEmail.style.display = 'block';
          if (emailEl) emailEl.style.borderColor = '#C0410A';
          valid = false;
        } else {
          if (errEmail) errEmail.style.display = 'none';
          if (emailEl) emailEl.style.borderColor = 'var(--color-grey-200)';
        }
        if (state.description.length < MIN_DESC_CHARS) {
          if (errDesc) errDesc.style.display = 'block';
          if (descEl) descEl.style.borderColor = '#C0410A';
          valid = false;
        } else {
          if (errDesc) errDesc.style.display = 'none';
          if (descEl) descEl.style.borderColor = 'var(--color-grey-200)';
        }
        return valid;
      }
      return true;
    }

    window.selectBusinessType = function(btn) {
      state.businessType = btn.getAttribute('data-value');
      try { localStorage.setItem('mi_user_type', state.businessType); } catch(e) {}
      document.querySelectorAll('.type-card').forEach(function(c) {
        c.style.borderColor = 'var(--color-grey-200)';
        c.style.background = 'var(--color-white)';
        c.style.transform = 'none';
        var chk = c.querySelector('.selected-check');
        if (chk) chk.style.display = 'none';
      });
      btn.style.borderColor = 'var(--color-accent)';
      btn.style.background = '#FFF8F5';
      btn.style.transform = 'translateY(-2px)';
      var chk = btn.querySelector('.selected-check');
      if (chk) chk.style.display = 'flex';
      var bizWrap = document.getElementById('business-name-wrap');
      if (bizWrap) {
        var lbl = bizWrap.querySelector('label');
        if (lbl) {
          if (state.businessType === 'individual') {
            lbl.innerHTML = 'Business / Project Name <span style="font-weight:400;color:var(--color-grey-600);">(optional)</span>';
          } else {
            lbl.innerHTML = 'Business Name <span style="color:var(--color-accent);">*</span>';
          }
        }
      }
      var errStep1 = document.getElementById('error-step1');
      if (errStep1) errStep1.style.display = 'none';
    };

    window.toggleService = function(btn) {
      var val = btn.getAttribute('data-value');
      var idx = state.services.indexOf(val);
      if (idx === -1) {
        state.services.push(val);
        btn.style.borderColor = 'var(--color-teal)';
        btn.style.background = '#F0FDFB';
        btn.style.transform = 'translateY(-2px)';
        var chk = btn.querySelector('.selected-check');
        if (chk) chk.style.display = 'flex';
      } else {
        state.services.splice(idx, 1);
        btn.style.borderColor = 'var(--color-grey-200)';
        btn.style.background = 'var(--color-white)';
        btn.style.transform = 'none';
        var chk2 = btn.querySelector('.selected-check');
        if (chk2) chk2.style.display = 'none';
      }
      var err2 = document.getElementById('error-step2');
      if (state.services.length > 0 && err2) err2.style.display = 'none';
      if (state.budget) updateQuoteEstimate();
    };

    window.selectBudget = function(btn) {
      state.budget = btn.getAttribute('data-value');
      document.querySelectorAll('.budget-card').forEach(function(c) {
        c.style.borderColor = 'var(--color-grey-200)';
        c.style.background = 'var(--color-white)';
        var chk = c.querySelector('.selected-check');
        if (chk) chk.style.display = 'none';
      });
      btn.style.borderColor = 'var(--color-accent)';
      btn.style.background = '#FFF8F5';
      var chk = btn.querySelector('.selected-check');
      if (chk) chk.style.display = 'flex';
      updateQuoteEstimate();
      var err3 = document.getElementById('error-step3');
      if (state.timeline && err3) err3.style.display = 'none';
    };

    window.selectTimeline = function(btn) {
      state.timeline = btn.getAttribute('data-value');
      document.querySelectorAll('.timeline-card').forEach(function(c) {
        c.style.borderColor = 'var(--color-grey-200)';
        c.style.background = 'var(--color-white)';
        var chk = c.querySelector('.selected-check');
        if (chk) chk.style.display = 'none';
      });
      btn.style.borderColor = 'var(--color-primary)';
      btn.style.background = '#F3F5F8';
      var chk = btn.querySelector('.selected-check');
      if (chk) chk.style.display = 'flex';
      var err3 = document.getElementById('error-step3');
      if (state.budget && err3) err3.style.display = 'none';
    };

    function updateQuoteEstimate() {
      var q = computeQuote();
      var box = document.getElementById('quote-estimate');
      var txt = document.getElementById('quote-text');
      if (!box || !txt) return;
      if (q) { txt.textContent = q; box.style.display = 'block'; }
      else { box.style.display = 'none'; }
    }

    window.updateCharCount = function(el) {
      var count = el.value.length;
      var span = document.getElementById('char-count');
      if (!span) return;
      if (count >= MIN_DESC_CHARS) {
        span.textContent = '(' + count + ' chars ✓)';
        span.style.color = 'var(--color-teal)';
        var errDesc = document.getElementById('err-desc');
        if (errDesc) errDesc.style.display = 'none';
        el.style.borderColor = 'var(--color-grey-200)';
      } else {
        span.textContent = '(' + count + ' / ' + MIN_DESC_CHARS + ' min)';
        span.style.color = 'var(--color-grey-600)';
      }
    };

    function populateSummary() {
      state.fullName = ((document.getElementById('full-name') || {}).value || state.fullName || '').trim();
      state.businessName = ((document.getElementById('business-name') || {}).value || state.businessName || '').trim();
      state.email = ((document.getElementById('email-addr') || {}).value || state.email || '').trim();
      state.phone = ((document.getElementById('phone') || {}).value || '').trim();
      state.city = (document.getElementById('city') || {}).value || '';
      state.referral = (document.getElementById('referral') || {}).value || '';
      state.description = ((document.getElementById('description') || {}).value || state.description || '').trim();

      setText('sum-type', typeLabels[state.businessType] || '—');
      setText('sum-services', state.services.map(function(s) { return serviceLabels[s]; }).join(', ') || '—');
      setText('sum-budget', budgetLabels[state.budget] || '—');
      setText('sum-timeline', timelineLabels[state.timeline] || '—');
      var contactStr = state.fullName + (state.businessName ? ' · ' + state.businessName : '') + '\n' + state.email + (state.phone ? ' · ' + state.phone : '');
      setText('sum-contact', contactStr);
      setText('sum-city', cityLabels[state.city] || state.city || '—');
      setText('sum-desc', state.description || '—');
      var q = computeQuote();
      setText('sum-estimate-text', q || 'Complete budget and service selections to see an estimate.');
      buildWhatsAppLink();
    }

    function setText(id, val) {
      var el = document.getElementById(id);
      if (el) el.textContent = val;
    }

    function buildWhatsAppLink() {
      var msg = 'Hi Mapengo Innovations! I\'d like to request a quote.\n\n' +
        '*Business Type:* ' + (typeLabels[state.businessType] || 'N/A') + '\n' +
        '*Services:* ' + (state.services.map(function(s) { return serviceLabels[s]; }).join(', ') || 'N/A') + '\n' +
        '*Budget:* ' + (budgetLabels[state.budget] || 'N/A') + '\n' +
        '*Timeline:* ' + (timelineLabels[state.timeline] || 'N/A') + '\n' +
        '*Name:* ' + (state.fullName || 'N/A') + '\n' +
        '*Business:* ' + (state.businessName || 'N/A') + '\n' +
        '*Email:* ' + (state.email || 'N/A') + '\n' +
        '*Description:* ' + (state.description ? state.description.substring(0, 200) : 'N/A');
      var waUrl = 'https://wa.me/27600000000?text=' + encodeURIComponent(msg);
      var waBtn = document.getElementById('wa-prefill-btn');
      if (waBtn) waBtn.href = waUrl;
      var successWaBtn = document.getElementById('success-wa-btn');
      if (successWaBtn) successWaBtn.href = waUrl;
    }

    window.submitQuote = function() {
      var btn = document.getElementById('submit-btn');
      if (btn) { btn.disabled = true; btn.style.opacity = '.7'; btn.textContent = 'Submitting…'; }
      try {
        var submission = {
          timestamp: new Date().toISOString(),
          businessType: state.businessType,
          services: state.services,
          budget: state.budget,
          timeline: state.timeline,
          fullName: state.fullName,
          businessName: state.businessName,
          email: state.email,
          city: state.city,
          referral: state.referral
        };
        var history = JSON.parse(localStorage.getItem('mi_quote_history') || '[]');
        history.push(submission);
        localStorage.setItem('mi_quote_history', JSON.stringify(history.slice(-10)));
      } catch(e) {}
      setTimeout(function() {
        document.querySelectorAll('.form-step').forEach(function(el) { el.style.display = 'none'; });
        var successEl = document.getElementById('step-success');
        if (successEl) successEl.style.display = 'block';
        var nameSpan = document.getElementById('success-name');
        var firstName = (state.fullName || '').split(' ')[0];
        if (nameSpan && firstName) nameSpan.textContent = firstName;
        buildWhatsAppLink();
        updateProgress(6);
        var pb = document.getElementById('progress-bar');
        if (pb) pb.style.opacity = '.4';
        var formEl = document.getElementById('quote-form');
        if (formEl) formEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 900);
    };

    // Restore saved business type
    try {
      var savedType = localStorage.getItem('mi_user_type');
      if (savedType) state.businessType = savedType;
    } catch(e) {}

    updateProgress(1);

  })();
  </script>

</BaseLayout>
