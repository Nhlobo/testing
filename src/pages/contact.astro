---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---

<BaseLayout
  title="Get a Free Quote"
  description="Get a tailored project quote from Mapengo Innovations. Tell us your requirements in 5 steps and receive a personalised proposal within 24 hours."
>
  <header style="background:var(--color-primary);color:var(--color-white);padding:var(--space-3) var(--space-4);position:sticky;top:0;z-index:200;box-shadow:0 2px 12px rgba(0,0,0,.25);">
    <nav style="max-width:var(--max-width);margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-2);">
      <a href={base} style="font-family:var(--font-heading);font-size:1.5rem;font-weight:800;color:var(--color-white);text-decoration:none;letter-spacing:-.5px;">Mapengo<span style="color:var(--color-accent);">.</span></a>
      <ul style="list-style:none;display:flex;gap:var(--space-3);margin:0;padding:0;flex-wrap:wrap;align-items:center;">
        <li><a href={`${base}services/`} style="color:rgba(255,255,255,.85);text-decoration:none;font-size:.9rem;font-weight:500;">Services</a></li>
        <li><a href={`${base}industries/`} style="color:rgba(255,255,255,.85);text-decoration:none;font-size:.9rem;font-weight:500;">Industries</a></li>
        <li><a href={`${base}case-studies/`} style="color:rgba(255,255,255,.85);text-decoration:none;font-size:.9rem;font-weight:500;">Case Studies</a></li>
        <li><a href={`${base}about/`} style="color:rgba(255,255,255,.85);text-decoration:none;font-size:.9rem;font-weight:500;">About</a></li>
        <li><a href={`${base}blog/`} style="color:rgba(255,255,255,.85);text-decoration:none;font-size:.9rem;font-weight:500;">Blog</a></li>
        <li><a href={`${base}contact/`} style="background:var(--color-accent);color:var(--color-white);padding:9px 22px;border-radius:var(--radius-full);text-decoration:none;font-weight:700;font-size:.9rem;">Get Quote</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section style="background:linear-gradient(135deg,#0A1628 0%,#0f2040 60%,#1a2e50 100%);color:var(--color-white);padding:var(--space-12) var(--space-4) var(--space-10);text-align:center;position:relative;overflow:hidden;">
      <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 70% 50%,rgba(0,201,167,.08) 0%,transparent 60%),radial-gradient(ellipse at 20% 80%,rgba(255,107,53,.06) 0%,transparent 50%);pointer-events:none;"></div>
      <div style="position:relative;max-width:720px;margin:0 auto;">
        <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(0,201,167,.12);border:1px solid rgba(0,201,167,.25);border-radius:var(--radius-full);padding:6px 16px;margin-bottom:var(--space-3);">
          <span style="width:8px;height:8px;background:var(--color-teal);border-radius:50%;display:inline-block;animation:pulse-dot 1.8s ease-in-out infinite;"></span>
          <span style="font-size:.8rem;font-weight:600;color:var(--color-teal);letter-spacing:.5px;text-transform:uppercase;">Free No-Obligation Quote</span>
        </div>
        <h1 style="font-family:var(--font-heading);font-size:clamp(2.2rem,5vw,3.5rem);font-weight:800;line-height:1.1;margin-bottom:var(--space-2);letter-spacing:-.02em;">Build Something<br/><span style="color:var(--color-accent);">Extraordinary</span></h1>
        <p style="font-size:1.15rem;opacity:.85;line-height:1.7;margin-bottom:var(--space-4);max-width:560px;margin-left:auto;margin-right:auto;">Tell us about your vision in 5 quick steps — we&#39;ll craft a personalised proposal with transparent ZAR pricing, delivered within 24 hours.</p>
        <div style="display:flex;justify-content:center;gap:var(--space-3);flex-wrap:wrap;font-size:.875rem;opacity:.75;">
          <span>&#10003; No hidden fees</span>
          <span>&#10003; SA-based team</span>
          <span>&#10003; Response within 24 hours</span>
          <span>&#10003; POPIA compliant</span>
        </div>
      </div>
    </section>

    <section id="quote-form" style="padding:var(--space-10) var(--space-4) var(--space-12);background:var(--color-grey-50);">
      <div style="max-width:820px;margin:0 auto;">

        <!-- Progress Indicator -->
        <div id="progress-bar" style="margin-bottom:var(--space-6);">
          <div style="display:flex;align-items:center;justify-content:center;gap:0;position:relative;padding:0 var(--space-4);">
            <div style="position:absolute;top:20px;left:calc(10% + 20px);right:calc(10% + 20px);height:2px;background:var(--color-grey-200);z-index:0;"></div>
            <div id="progress-line" style="position:absolute;top:20px;left:calc(10% + 20px);width:0%;height:2px;background:var(--color-accent);z-index:1;transition:width .4s ease;"></div>
            <div style="display:flex;justify-content:space-between;width:100%;position:relative;z-index:2;">
              <div style="display:flex;flex-direction:column;align-items:center;gap:8px;flex:1;">
                <div id="dot-1" style="width:40px;height:40px;border-radius:50%;background:var(--color-accent);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.875rem;transition:all .3s;box-shadow:0 2px 8px rgba(255,107,53,.4);">1</div>
                <span id="dot-label-1" style="font-size:.72rem;font-weight:600;color:var(--color-accent);text-align:center;line-height:1.2;">Business<br/>Type</span>
              </div>
              <div style="display:flex;flex-direction:column;align-items:center;gap:8px;flex:1;">
                <div id="dot-2" style="width:40px;height:40px;border-radius:50%;background:var(--color-grey-200);color:var(--color-grey-600);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.875rem;transition:all .3s;">2</div>
                <span id="dot-label-2" style="font-size:.72rem;font-weight:500;color:var(--color-grey-600);text-align:center;line-height:1.2;">Services<br/>Needed</span>
              </div>
              <div style="display:flex;flex-direction:column;align-items:center;gap:8px;flex:1;">
                <div id="dot-3" style="width:40px;height:40px;border-radius:50%;background:var(--color-grey-200);color:var(--color-grey-600);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.875rem;transition:all .3s;">3</div>
                <span id="dot-label-3" style="font-size:.72rem;font-weight:500;color:var(--color-grey-600);text-align:center;line-height:1.2;">Budget &amp;<br/>Timeline</span>
              </div>
              <div style="display:flex;flex-direction:column;align-items:center;gap:8px;flex:1;">
                <div id="dot-4" style="width:40px;height:40px;border-radius:50%;background:var(--color-grey-200);color:var(--color-grey-600);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.875rem;transition:all .3s;">4</div>
                <span id="dot-label-4" style="font-size:.72rem;font-weight:500;color:var(--color-grey-600);text-align:center;line-height:1.2;">Project<br/>Details</span>
              </div>
              <div style="display:flex;flex-direction:column;align-items:center;gap:8px;flex:1;">
                <div id="dot-5" style="width:40px;height:40px;border-radius:50%;background:var(--color-grey-200);color:var(--color-grey-600);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.875rem;transition:all .3s;">5</div>
                <span id="dot-label-5" style="font-size:.72rem;font-weight:500;color:var(--color-grey-600);text-align:center;line-height:1.2;">Review &amp;<br/>Submit</span>
              </div>
            </div>
          </div>
        </div>

        <div style="background:var(--color-white);border-radius:var(--radius-xl);box-shadow:var(--shadow-xl);overflow:hidden;">

          <!-- STEP 1: Business Type -->
          <div id="step-1" class="form-step">
            <div style="padding:var(--space-5) var(--space-5) var(--space-3);">
              <p style="font-size:.8rem;font-weight:600;color:var(--color-teal);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;">Step 1 of 5</p>
              <h2 style="font-family:var(--font-heading);font-size:1.75rem;font-weight:800;color:var(--color-primary);margin-bottom:8px;">Who are you building for?</h2>
              <p style="color:var(--color-grey-600);font-size:.95rem;">This helps us tailor our recommendation and pricing to your scale.</p>
            </div>
            <div style="padding:0 var(--space-5) var(--space-5);">
              <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:var(--space-2);" id="business-type-grid">

                <button type="button" class="type-card" data-value="individual" onclick="selectBusinessType(this)"
                  style="text-align:left;padding:var(--space-3);border:2px solid var(--color-grey-200);border-radius:var(--radius-lg);background:var(--color-white);cursor:pointer;transition:all .2s;position:relative;">
                  <div style="font-size:2rem;margin-bottom:10px;">&#128100;</div>
                  <div style="font-family:var(--font-heading);font-weight:700;font-size:1rem;color:var(--color-primary);margin-bottom:4px;">Individual / Freelancer</div>
                  <div style="font-size:.8rem;color:var(--color-grey-600);line-height:1.5;">Personal projects, portfolios, or side businesses needing a professional digital presence.</div>
                  <div class="selected-check" style="display:none;position:absolute;top:12px;right:12px;width:24px;height:24px;background:var(--color-teal);border-radius:50%;color:#fff;font-size:.75rem;align-items:center;justify-content:center;font-weight:700;">&#10003;</div>
                </button>

                <button type="button" class="type-card" data-value="startup" onclick="selectBusinessType(this)"
                  style="text-align:left;padding:var(--space-3);border:2px solid var(--color-grey-200);border-radius:var(--radius-lg);background:var(--color-white);cursor:pointer;transition:all .2s;position:relative;">
                  <div style="font-size:2rem;margin-bottom:10px;">&#128640;</div>
                  <div style="font-family:var(--font-heading);font-weight:700;font-size:1rem;color:var(--color-primary);margin-bottom:4px;">Startup</div>
                  <div style="font-size:.8rem;color:var(--color-grey-600);line-height:1.5;">Early-stage business under R1M revenue. Speed to market and lean budgets matter most.</div>
                  <div class="selected-check" style="display:none;position:absolute;top:12px;right:12px;width:24px;height:24px;background:var(--color-teal);border-radius:50%;color:#fff;font-size:.75rem;align-items:center;justify-content:center;font-weight:700;">&#10003;</div>
                </button>

                <button type="button" class="type-card" data-value="sme" onclick="selectBusinessType(this)"
                  style="text-align:left;padding:var(--space-3);border:2px solid var(--color-grey-200);border-radius:var(--radius-lg);background:var(--color-white);cursor:pointer;transition:all .2s;position:relative;">
                  <div style="font-size:2rem;margin-bottom:10px;">&#127970;</div>
                  <div style="font-family:var(--font-heading);font-weight:700;font-size:1rem;color:var(--color-primary);margin-bottom:4px;">SME (R1M&#8211;R10M)</div>
                  <div style="font-size:.8rem;color:var(--color-grey-600);line-height:1.5;">Growing business needing robust systems, automation, and scalable digital infrastructure.</div>
                  <div class="selected-check" style="display:none;position:absolute;top:12px;right:12px;width:24px;height:24px;background:var(--color-teal);border-radius:50%;color:#fff;font-size:.75rem;align-items:center;justify-content:center;font-weight:700;">&#10003;</div>
                </button>

                <button type="button" class="type-card" data-value="enterprise" onclick="selectBusinessType(this)"
                  style="text-align:left;padding:var(--space-3);border:2px solid var(--color-grey-200);border-radius:var(--radius-lg);background:var(--color-white);cursor:pointer;transition:all .2s;position:relative;">
                  <div style="font-size:2rem;margin-bottom:10px;">&#127963;</div>
                  <div style="font-family:var(--font-heading);font-weight:700;font-size:1rem;color:var(--color-primary);margin-bottom:4px;">Enterprise (R10M+)</div>
                  <div style="font-size:.8rem;color:var(--color-grey-600);line-height:1.5;">Large organisations requiring enterprise-grade architecture, integrations, and SLAs.</div>
                  <div class="selected-check" style="display:none;position:absolute;top:12px;right:12px;width:24px;height:24px;background:var(--color-teal);border-radius:50%;color:#fff;font-size:.75rem;align-items:center;justify-content:center;font-weight:700;">&#10003;</div>
                </button>

                <button type="button" class="type-card" data-value="government" onclick="selectBusinessType(this)"
                  style="text-align:left;padding:var(--space-3);border:2px solid var(--color-grey-200);border-radius:var(--radius-lg);background:var(--color-white);cursor:pointer;transition:all .2s;position:relative;">
                  <div style="font-size:2rem;margin-bottom:10px;">&#127970;</div>
                  <div style="font-family:var(--font-heading);font-weight:700;font-size:1rem;color:var(--color-primary);margin-bottom:4px;">Government / NGO</div>
                  <div style="font-size:.8rem;color:var(--color-grey-600);line-height:1.5;">Public sector and non-profit entities with compliance, accessibility, and impact focus.</div>
                  <div class="selected-check" style="display:none;position:absolute;top:12px;right:12px;width:24px;height:24px;background:var(--color-teal);border-radius:50%;color:#fff;font-size:.75rem;align-items:center;justify-content:center;font-weight:700;">&#10003;</div>
                </button>

              </div>
              <div id="error-step1" style="display:none;margin-top:var(--space-2);padding:12px 16px;background:#FFF5F0;border:1px solid #FFD0B5;border-radius:var(--radius-md);color:#C0410A;font-size:.875rem;font-weight:500;">&#9888; Please select your business type to continue.</div>
            </div>
            <div style="padding:var(--space-4) var(--space-5);border-top:1px solid var(--color-grey-100);display:flex;justify-content:flex-end;">
              <button type="button" onclick="goToStep(2)" style="background:var(--color-accent);color:#fff;padding:14px 36px;border-radius:var(--radius-full);border:none;font-size:1rem;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:8px;">
                Continue &#8594;
              </button>
            </div>
          </div>

          <!-- STEP 2: Service Selection -->
          <div id="step-2" class="form-step" style="display:none;">
            <div style="padding:var(--space-5) var(--space-5) var(--space-3);">
              <p style="font-size:.8rem;font-weight:600;color:var(--color-teal);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;">Step 2 of 5</p>
              <h2 style="font-family:var(--font-heading);font-size:1.75rem;font-weight:800;color:var(--color-primary);margin-bottom:8px;">What do you need built?</h2>
              <p style="color:var(--color-grey-600);font-size:.95rem;">Select all that apply &#8212; you can choose multiple services for a bundled quote.</p>
            </div>
            <div style="padding:0 var(--space-5) var(--space-5);">
              <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:var(--space-2);">

                <button type="button" class="service-card" data-value="web" onclick="toggleService(this)"
                  style="text-align:left;padding:var(--space-3);border:2px solid var(--color-grey-200);border-radius:var(--radius-lg);background:var(--color-white);cursor:pointer;transition:all .2s;position:relative;">
                  <div style="font-size:2rem;margin-bottom:10px;">&#127760;</div>
                  <div style="font-family:var(--font-heading);font-weight:700;font-size:1rem;color:var(--color-primary);margin-bottom:4px;">Web Development</div>
                  <div style="font-size:.8rem;color:var(--color-grey-600);line-height:1.5;">Custom websites, landing pages, and web apps built for performance and conversions.</div>
                  <div class="selected-check" style="display:none;position:absolute;top:12px;right:12px;width:24px;height:24px;background:var(--color-teal);border-radius:50%;color:#fff;font-size:.75rem;align-items:center;justify-content:center;font-weight:700;">&#10003;</div>
                </button>

                <button type="button" class="service-card" data-value="mobile" onclick="toggleService(this)"
                  style="text-align:left;padding:var(--space-3);border:2px solid var(--color-grey-200);border-radius:var(--radius-lg);background:var(--color-white);cursor:pointer;transition:all .2s;position:relative;">
                  <div style="font-size:2rem;margin-bottom:10px;">&#128241;</div>
                  <div style="font-family:var(--font-heading);font-weight:700;font-size:1rem;color:var(--color-primary);margin-bottom:4px;">Mobile App</div>
                  <div style="font-size:.8rem;color:var(--color-grey-600);line-height:1.5;">iOS and Android apps &#8212; from consumer-facing products to internal field tools.</div>
                  <div class="selected-check" style="display:none;position:absolute;top:12px;right:12px;width:24px;height:24px;background:var(--color-teal);border-radius:50%;color:#fff;font-size:.75rem;align-items:center;justify-content:center;font-weight:700;">&#10003;</div>
                </button>

                <button type="button" class="service-card" data-value="ecommerce" onclick="toggleService(this)"
                  style="text-align:left;padding:var(--space-3);border:2px solid var(--color-grey-200);border-radius:var(--radius-lg);background:var(--color-white);cursor:pointer;transition:all .2s;position:relative;">
                  <div style="font-size:2rem;margin-bottom:10px;">&#128722;</div>
                  <div style="font-family:var(--font-heading);font-weight:700;font-size:1rem;color:var(--color-primary);margin-bottom:4px;">E-Commerce Store</div>
                  <div style="font-size:.8rem;color:var(--color-grey-600);line-height:1.5;">Online stores with local payment gateways (PayFast, Peach Payments, SnapScan).</div>
                  <div class="selected-check" style="display:none;position:absolute;top:12px;right:12px;width:24px;height:24px;background:var(--color-teal);border-radius:50%;color:#fff;font-size:.75rem;align-items:center;justify-content:center;font-weight:700;">&#10003;</div>
                </button>

                <button type="button" class="service-card" data-value="erp" onclick="toggleService(this)"
                  style="text-align:left;padding:var(--space-3);border:2px solid var(--color-grey-200);border-radius:var(--radius-lg);background:var(--color-white);cursor:pointer;transition:all .2s;position:relative;">
                  <div style="font-size:2rem;margin-bottom:10px;">&#9881;&#65039;</div>
                  <div style="font-family:var(--font-heading);font-weight:700;font-size:1rem;color:var(--color-primary);margin-bottom:4px;">Business System / ERP</div>
                  <div style="font-size:.8rem;color:var(--color-grey-600);line-height:1.5;">Custom CRMs, ERPs, inventory, HR, and workflow automation tailored to your processes.</div>
                  <div class="selected-check" style="display:none;position:absolute;top:12px;right:12px;width:24px;height:24px;background:var(--color-teal);border-radius:50%;color:#fff;font-size:.75rem;align-items:center;justify-content:center;font-weight:700;">&#10003;</div>
                </button>

                <button type="button" class="service-card" data-value="design" onclick="toggleService(this)"
                  style="text-align:left;padding:var(--space-3);border:2px solid var(--color-grey-200);border-radius:var(--radius-lg);background:var(--color-white);cursor:pointer;transition:all .2s;position:relative;">
                  <div style="font-size:2rem;margin-bottom:10px;">&#127912;</div>
                  <div style="font-family:var(--font-heading);font-weight:700;font-size:1rem;color:var(--color-primary);margin-bottom:4px;">UI/UX Design</div>
                  <div style="font-size:.8rem;color:var(--color-grey-600);line-height:1.5;">User research, wireframes, prototypes, and pixel-perfect design systems.</div>
                  <div class="selected-check" style="display:none;position:absolute;top:12px;right:12px;width:24px;height:24px;background:var(--color-teal);border-radius:50%;color:#fff;font-size:.75rem;align-items:center;justify-content:center;font-weight:700;">&#10003;</div>
                </button>

                <button type="button" class="service-card" data-value="cloud" onclick="toggleService(this)"
                  style="text-align:left;padding:var(--space-3);border:2px solid var(--color-grey-200);border-radius:var(--radius-lg);background:var(--color-white);cursor:pointer;transition:all .2s;position:relative;">
                  <div style="font-size:2rem;margin-bottom:10px;">&#9729;&#65039;</div>
                  <div style="font-family:var(--font-heading);font-weight:700;font-size:1rem;color:var(--color-primary);margin-bottom:4px;">Cloud Infrastructure</div>
                  <div style="font-size:.8rem;color:var(--color-grey-600);line-height:1.5;">AWS, GCP, Azure deployments, DevOps pipelines, and managed hosting solutions.</div>
                  <div class="selected-check" style="display:none;position:absolute;top:12px;right:12px;width:24px;height:24px;background:var(--color-teal);border-radius:50%;color:#fff;font-size:.75rem;align-items:center;justify-content:center;font-weight:700;">&#10003;</div>
                </button>

              </div>
              <div id="error-step2" style="display:none;margin-top:var(--space-2);padding:12px 16px;background:#FFF5F0;border:1px solid #FFD0B5;border-radius:var(--radius-md);color:#C0410A;font-size:.875rem;font-weight:500;">&#9888; Please select at least one service to continue.</div>
            </div>
            <div style="padding:var(--space-4) var(--space-5);border-top:1px solid var(--color-grey-100);display:flex;justify-content:space-between;align-items:center;">
              <button type="button" onclick="goToStep(1)" style="background:none;border:2px solid var(--color-grey-200);color:var(--color-grey-600);padding:13px 28px;border-radius:var(--radius-full);font-size:.95rem;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:8px;">
                &#8592; Back
              </button>
              <button type="button" onclick="goToStep(3)" style="background:var(--color-accent);color:#fff;padding:14px 36px;border-radius:var(--radius-full);border:none;font-size:1rem;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:8px;">
                Continue &#8594;
              </button>
            </div>
          </div>

          <!-- STEP 3: Budget & Timeline -->
          <div id="step-3" class="form-step" style="display:none;">
            <div style="padding:var(--space-5) var(--space-5) var(--space-3);">
              <p style="font-size:.8rem;font-weight:600;color:var(--color-teal);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;">Step 3 of 5</p>
              <h2 style="font-family:var(--font-heading);font-size:1.75rem;font-weight:800;color:var(--color-primary);margin-bottom:8px;">Budget &amp; Timeline</h2>
              <p style="color:var(--color-grey-600);font-size:.95rem;">Honest numbers help us propose the right solution &#8212; no judgement, all brackets are valid.</p>
            </div>
            <div style="padding:0 var(--space-5) var(--space-5);">
              <h3 style="font-family:var(--font-heading);font-weight:700;color:var(--color-primary);font-size:1.1rem;margin-bottom:var(--space-2);">Investment Range (ZAR)</h3>
              <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:var(--space-1);">

                <button type="button" class="budget-card" data-value="under15k" onclick="selectBudget(this)"
