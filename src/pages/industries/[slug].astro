---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const industries = await getCollection('industries');
  return industries.map(ind => ({
    params: { slug: ind.data.slug },
    props: { ind },
  }));
}

const { ind } = Astro.props;
const { Content } = await render(ind);
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---

<BaseLayout
  title={`${ind.data.title} Solutions South Africa`}
  description={ind.data.description}
>
  <header style="background:var(--color-primary);color:var(--color-white);padding:var(--space-6) var(--space-4);">
    <nav style="max-width:var(--max-width);margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-2);">
      <a href={base} style="font-family:var(--font-heading);font-size:1.5rem;font-weight:800;color:var(--color-white);text-decoration:none;">Mapengo<span style="color:var(--color-accent);">.</span></a>
      <ul style="list-style:none;display:flex;gap:var(--space-3);margin:0;padding:0;flex-wrap:wrap;">
        <li><a href={`${base}services/`} style="color:var(--color-white);text-decoration:none;">Services</a></li>
        <li><a href={`${base}industries/`} style="color:var(--color-accent);text-decoration:none;font-weight:600;">Industries</a></li>
        <li><a href={`${base}work/`} style="color:var(--color-white);text-decoration:none;">Work</a></li>
        <li><a href={`${base}pricing/`} style="color:var(--color-white);text-decoration:none;">Pricing</a></li>
        <li><a href={`${base}contact/`} style="background:var(--color-accent);color:var(--color-white);padding:8px 20px;border-radius:var(--radius-full);text-decoration:none;font-weight:600;">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section style="background:var(--color-primary);color:var(--color-white);padding:var(--space-12) var(--space-4);">
      <div style="max-width:var(--max-width);margin:0 auto;">
        <a href={`${base}industries/`} style="color:rgba(255,255,255,.6);font-size:.9rem;text-decoration:none;display:inline-flex;align-items:center;gap:6px;margin-bottom:var(--space-3);">← All Industries</a>
        <div style="display:flex;align-items:center;gap:var(--space-2);margin-bottom:var(--space-3);">
          <span style="font-size:3rem;">{ind.data.icon}</span>
          <h1 style="font-family:var(--font-heading);font-size:clamp(2rem,4vw,3rem);font-weight:800;">{ind.data.title}</h1>
        </div>
        <p style="font-size:1.15rem;opacity:.85;max-width:680px;">{ind.data.description}</p>
      </div>
    </section>

    <!-- Challenges + Solutions -->
    <section style="padding:var(--space-12) var(--space-4);background:var(--color-grey-50);">
      <div style="max-width:var(--max-width);margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:var(--space-6);">
        <div style="background:var(--color-white);padding:var(--space-4);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);">
          <h2 style="font-family:var(--font-heading);font-size:1.25rem;font-weight:700;color:var(--color-primary);margin-bottom:var(--space-3);">Challenges We Solve</h2>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:var(--space-2);">
            {ind.data.challenges.map(c => (
              <li style="display:flex;gap:var(--space-1);align-items:flex-start;font-size:.95rem;color:var(--color-grey-800);">
                <span style="color:#e53e3e;flex-shrink:0;margin-top:2px;">✗</span>{c}
              </li>
            ))}
          </ul>
        </div>
        <div style="background:var(--color-primary);padding:var(--space-4);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);color:var(--color-white);">
          <h2 style="font-family:var(--font-heading);font-size:1.25rem;font-weight:700;margin-bottom:var(--space-3);">Our Solutions</h2>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:var(--space-2);">
            {ind.data.solutions.map(s => (
              <li style="display:flex;gap:var(--space-1);align-items:flex-start;font-size:.95rem;opacity:.9;">
                <span style="color:var(--color-teal);flex-shrink:0;margin-top:2px;">✓</span>{s}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Content body -->
    <section style="padding:var(--space-12) var(--space-4);">
      <div style="max-width:780px;margin:0 auto;">
        <article class="prose">
          <Content />
        </article>
      </div>
    </section>

    <!-- CTA -->
    <section style="background:var(--color-accent);color:var(--color-white);padding:var(--space-10) var(--space-4);text-align:center;">
      <h2 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;margin-bottom:var(--space-2);">Ready to Transform Your {ind.data.title} Business?</h2>
      <p style="opacity:.9;margin-bottom:var(--space-4);font-size:1.05rem;">Let's talk about your specific challenges and build the right solution.</p>
      <div style="display:flex;gap:var(--space-2);justify-content:center;flex-wrap:wrap;">
        <a href={`${base}contact/`} data-smart-cta style="background:var(--color-white);color:var(--color-accent);padding:14px 32px;border-radius:var(--radius-full);font-weight:700;text-decoration:none;">Book a Free Consultation</a>
        <a href={`${base}pricing/`} style="border:2px solid rgba(255,255,255,.5);color:var(--color-white);padding:14px 32px;border-radius:var(--radius-full);font-weight:600;text-decoration:none;">View Pricing</a>
      </div>
    </section>
  </main>

  <footer style="background:var(--color-primary);color:rgba(255,255,255,.7);padding:var(--space-6) var(--space-4);text-align:center;font-size:.9rem;">
    <p>&copy; {new Date().getFullYear()} Mapengo Innovations — <a href={`${base}legal/privacy/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Privacy</a> · <a href={`${base}legal/terms/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Terms</a></p>
  </footer>
</BaseLayout>

<style>
  .prose h2 { font-family: var(--font-heading); font-size: 1.5rem; font-weight: 700; color: var(--color-primary); margin: var(--space-5) 0 var(--space-2); }
  .prose h3 { font-family: var(--font-heading); font-size: 1.15rem; font-weight: 700; color: var(--color-primary); margin: var(--space-3) 0 var(--space-1); }
  .prose p { color: var(--color-grey-800); line-height: 1.75; margin-bottom: var(--space-2); }
  .prose ul { padding-left: var(--space-3); margin-bottom: var(--space-3); }
  .prose ul li { color: var(--color-grey-800); line-height: 1.7; margin-bottom: 4px; list-style: disc; }
  .prose strong { color: var(--color-primary); font-weight: 700; }
</style>
