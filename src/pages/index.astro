  <script is:inline>
    // Restore audience card highlight from localStorage
    (function() {
      const saved = localStorage.getItem('mi_user_type');
      if (saved) {
        const card = document.querySelector('[data-audience="' + saved + '"]');
        if (card) {
          const accent = card.style.borderTopColor || '#FF6B35';
          card.style.outline = '2px solid ' + accent;
        }
      }
    })();
  </script>
