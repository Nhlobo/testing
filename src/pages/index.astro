          <a href={`${base}contact/`} data-analytics-cta="footer-cta-quote" style="background:var(--color-accent);color:var(--color-white);padding:17px 42px;border-radius:var(--radius-full);font-weight:700;font-size:1.05rem;text-decoration:none;box-shadow:0 4px 24px rgba(255,107,53,.4);" onmouseover="this.style.background='#e85a24'" onmouseout="this.style.background='var(--color-accent)'">Get a Free Quote</a>
