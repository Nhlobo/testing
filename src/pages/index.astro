        <p style="color:var(--color-grey-600);font-size:1.05rem;max-width:520px;margin:0 auto var(--space-8);">We don't build generic software. Every solution is contextualised for your sector, your regulatory environment, and your growth stage.</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:var(--space-2);">
          {industries.map(ind => (
            <a href={`${base}industries/${ind.data.slug}/`}
