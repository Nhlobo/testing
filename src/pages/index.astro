---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
const caseStudies = (await getCollection('caseStudies')).filter(cs => cs.data.featured).slice(0, 3);
const industries = (await getCollection('industries')).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
---

<BaseLayout
  title="Mapengo Innovations — Digital Solutions for South African Businesses"
  description="We build fast, modern websites and apps that help South African businesses grow. From web development to mobile apps, cloud hosting and beyond."
>
  <header style="background:var(--color-primary);color:var(--color-white);padding:var(--space-6) var(--space-4);">
    <nav style="max-width:var(--max-width);margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-2);">
      <a href={base} style="font-family:var(--font-heading);font-size:1.5rem;font-weight:800;color:var(--color-white);text-decoration:none;">Mapengo<span style="color:var(--color-accent);">.</span></a>
      <ul style="list-style:none;display:flex;gap:var(--space-3);margin:0;padding:0;flex-wrap:wrap;">
        <li><a href={`${base}services/`} style="color:var(--color-white);text-decoration:none;">Services</a></li>
        <li><a href={`${base}industries/`} style="color:var(--color-white);text-decoration:none;">Industries</a></li>
        <li><a href={`${base}work/`} style="color:var(--color-white);text-decoration:none;">Work</a></li>
        <li><a href={`${base}pricing/`} style="color:var(--color-white);text-decoration:none;">Pricing</a></li>
        <li><a href={`${base}blog/`} style="color:var(--color-white);text-decoration:none;">Blog</a></li>
        <li><a href={`${base}contact/`} style="background:var(--color-accent);color:var(--color-white);padding:8px 20px;border-radius:var(--radius-full);text-decoration:none;font-weight:600;">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section style="background:var(--color-primary);color:var(--color-white);padding:var(--space-16) var(--space-4);text-align:center;">
      <div style="max-width:800px;margin:0 auto;">
        <p style="color:var(--color-accent);font-weight:600;letter-spacing:2px;text-transform:uppercase;margin-bottom:var(--space-2);font-size:.85rem;">South African Digital Innovation</p>
        <h1 style="font-family:var(--font-heading);font-size:clamp(2.5rem,6vw,4.5rem);font-weight:800;line-height:1.1;margin-bottom:var(--space-3);">
          We Build Digital Products<br/>That <span style="color:var(--color-accent);">Drive Growth</span>
        </h1>
        <p style="font-size:1.25rem;opacity:.85;max-width:600px;margin:0 auto var(--space-5);">
          From Johannesburg to Cape Town — websites, mobile apps, and custom systems built for the South African market.
        </p>
        <div style="display:flex;gap:var(--space-2);justify-content:center;flex-wrap:wrap;">
          <a href={`${base}contact/`} data-smart-cta data-analytics-cta="hero-primary" style="background:var(--color-accent);color:var(--color-white);padding:16px 36px;border-radius:var(--radius-full);font-weight:700;font-size:1.1rem;text-decoration:none;">Start Your Project</a>
          <a href={`${base}work/`} style="border:2px solid rgba(255,255,255,.4);color:var(--color-white);padding:16px 36px;border-radius:var(--radius-full);font-weight:600;text-decoration:none;">View Our Work</a>
        </div>
      </div>
    </section>

    <!-- Trust Metrics -->
    <section style="background:var(--color-accent);color:var(--color-white);padding:var(--space-6) var(--space-4);">
      <div style="max-width:var(--max-width);margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:var(--space-3);text-align:center;">
        {[
          { value: '50+', label: 'Projects Delivered' },
          { value: 'R5M+', label: 'Client Revenue Enabled' },
          { value: '95+', label: 'Avg Lighthouse Score' },
          { value: '6', label: 'Industries Served' },
          { value: '<1.5s', label: 'Avg Page Load' },
        ].map(s => (
          <div>
            <p style="font-family:var(--font-heading);font-size:1.75rem;font-weight:800;">{s.value}</p>
            <p style="opacity:.85;font-size:.8rem;">{s.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Services preview -->
    <section style="padding:var(--space-12) var(--space-4);background:var(--color-grey-50);">
      <div style="max-width:var(--max-width);margin:0 auto;text-align:center;">
        <h2 style="font-family:var(--font-heading);font-size:2.5rem;font-weight:800;color:var(--color-primary);margin-bottom:var(--space-2);">What We Build</h2>
        <p style="color:var(--color-grey-600);font-size:1.1rem;margin-bottom:var(--space-8);">End-to-end digital solutions for growing businesses.</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:var(--space-3);">
          {[
            { icon: '🌐', title: 'Web Development', desc: 'High-performance websites and web apps built with modern frameworks. Lighthouse 95+ guaranteed.', href: `${base}solutions/web-development-south-africa/` },
            { icon: '📱', title: 'Mobile Apps', desc: 'Cross-platform iOS and Android apps with React Native — built for SA connectivity.', href: `${base}services/mobile-apps/` },
            { icon: '⚙️', title: 'Business Systems', desc: 'Custom ERP, CRM, and automation systems — purpose-built for your workflows.', href: `${base}solutions/business-systems-south-africa/` },
            { icon: '🛒', title: 'E-Commerce', desc: 'Custom online stores with PayFast/Yoco integration and SA payment gateway support.', href: `${base}services/ecommerce/` },
          ].map(s => (
            <a href={s.href} style="background:var(--color-white);padding:var(--space-4);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);text-align:left;text-decoration:none;display:block;transition:box-shadow .2s;">
              <div style="font-size:2rem;margin-bottom:var(--space-2);">{s.icon}</div>
              <h3 style="font-family:var(--font-heading);font-size:1.25rem;font-weight:700;color:var(--color-primary);margin-bottom:8px;">{s.title}</h3>
              <p style="color:var(--color-grey-600);font-size:.95rem;">{s.desc}</p>
            </a>
          ))}
        </div>
        <a href={`${base}services/`} style="display:inline-block;margin-top:var(--space-6);color:var(--color-accent);font-weight:600;text-decoration:none;">View all services →</a>
      </div>
    </section>

    <!-- Industries grid -->
    <section style="padding:var(--space-12) var(--space-4);">
      <div style="max-width:var(--max-width);margin:0 auto;text-align:center;">
        <h2 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;color:var(--color-primary);margin-bottom:var(--space-2);">Built for South African Industries</h2>
        <p style="color:var(--color-grey-600);font-size:1rem;margin-bottom:var(--space-8);">We don't build generic software. We build for your industry, your context, your growth.</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:var(--space-2);">
          {industries.map(ind => (
            <a href={`${base}industries/${ind.data.slug}/`} style="background:var(--color-grey-50);padding:var(--space-3);border-radius:var(--radius-lg);text-decoration:none;text-align:center;transition:background .2s;display:block;" data-analytics-cta={`industry-${ind.data.slug}`}>
              <p style="font-size:2rem;margin-bottom:8px;">{ind.data.icon}</p>
              <p style="font-family:var(--font-heading);font-size:.9rem;font-weight:700;color:var(--color-primary);">{ind.data.title}</p>
            </a>
          ))}
        </div>
        <a href={`${base}industries/`} style="display:inline-block;margin-top:var(--space-5);color:var(--color-accent);font-weight:600;text-decoration:none;">All industries →</a>
      </div>
    </section>

    <!-- Featured Case Studies -->
    {caseStudies.length > 0 && (
      <section style="padding:var(--space-12) var(--space-4);background:var(--color-grey-50);">
        <div style="max-width:var(--max-width);margin:0 auto;">
          <div style="text-align:center;margin-bottom:var(--space-8);">
            <h2 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;color:var(--color-primary);margin-bottom:var(--space-2);">Real Results for SA Businesses</h2>
            <p style="color:var(--color-grey-600);">Not promises — proof.</p>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:var(--space-4);">
            {caseStudies.map(cs => {
              const slug = cs.id.replace(/\.mdx?$/, '');
              return (
                <a href={`${base}work/${slug}/`} style="background:var(--color-white);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm);text-decoration:none;display:flex;flex-direction:column;">
                  <div style="padding:var(--space-4);flex:1;">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-2);">
                      <span style="background:var(--color-grey-100);color:var(--color-grey-600);font-size:.75rem;font-weight:600;padding:4px 12px;border-radius:var(--radius-full);">{cs.data.category}</span>
                      <span style="font-size:.8rem;color:var(--color-grey-600);">{cs.data.year}</span>
                    </div>
                    <h3 style="font-family:var(--font-heading);font-size:1.1rem;font-weight:700;color:var(--color-primary);margin-bottom:4px;line-height:1.3;">{cs.data.title}</h3>
                    <p style="color:var(--color-grey-600);font-size:.85rem;margin-bottom:var(--space-3);">{cs.data.client}</p>
                    <div style="display:flex;gap:var(--space-3);">
                      {cs.data.metrics.slice(0, 3).map(m => (
                        <div>
                          <div style="font-family:var(--font-heading);font-size:1rem;font-weight:800;color:var(--color-accent);">{m.value}</div>
                          <div style="font-size:.7rem;color:var(--color-grey-600);">{m.label}</div>
                        </div>
                      ))}
                    </div>
                  </div>
                  <div style="padding:var(--space-2) var(--space-4);border-top:1px solid var(--color-grey-100);">
                    <span style="color:var(--color-accent);font-size:.85rem;font-weight:600;">Read case study →</span>
                  </div>
                </a>
              );
            })}
          </div>
          <div style="text-align:center;margin-top:var(--space-6);">
            <a href={`${base}work/`} style="color:var(--color-accent);font-weight:600;text-decoration:none;">View all case studies →</a>
          </div>
        </div>
      </section>
    )}

    <!-- Process teaser -->
    <section style="padding:var(--space-12) var(--space-4);">
      <div style="max-width:var(--max-width);margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:var(--space-4);align-items:center;">
        <div>
          <p style="color:var(--color-accent);font-weight:600;text-transform:uppercase;letter-spacing:2px;font-size:.85rem;margin-bottom:var(--space-2);">How We Work</p>
          <h2 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;color:var(--color-primary);margin-bottom:var(--space-3);">A Process Built for Clarity</h2>
          <p style="color:var(--color-grey-600);line-height:1.7;margin-bottom:var(--space-4);">No black boxes. No surprises. A disciplined 6-phase process that keeps you in control and delivers on time, every time.</p>
          <a href={`${base}process/`} style="color:var(--color-accent);font-weight:600;text-decoration:none;">See our process →</a>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-2);">
          {[
            { num: '01', label: 'Discovery & Strategy' },
            { num: '02', label: 'Design & Prototype' },
            { num: '03', label: 'Agile Development' },
            { num: '04', label: 'QA & Testing' },
            { num: '05', label: 'Launch & Deploy' },
            { num: '06', label: 'Support & Growth' },
          ].map(p => (
            <div style="background:var(--color-grey-50);padding:var(--space-2);border-radius:var(--radius-md);display:flex;align-items:center;gap:10px;">
              <span style="font-family:var(--font-heading);font-size:.85rem;font-weight:800;color:var(--color-accent);">{p.num}</span>
              <span style="font-size:.85rem;color:var(--color-primary);font-weight:600;">{p.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="background:var(--color-accent);color:var(--color-white);padding:var(--space-12) var(--space-4);text-align:center;">
      <h2 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;margin-bottom:var(--space-2);">Ready to Build Something Great?</h2>
      <p style="opacity:.9;margin-bottom:var(--space-4);font-size:1.1rem;">Let's talk about your project and how we can help.</p>
      <a href={`${base}contact/`} data-analytics-cta="bottom-cta" style="background:var(--color-white);color:var(--color-accent);padding:14px 36px;border-radius:var(--radius-full);font-weight:700;text-decoration:none;">Get in Touch</a>
    </section>
  </main>

  <footer style="background:var(--color-primary);color:rgba(255,255,255,.7);padding:var(--space-8) var(--space-4);">
    <div style="max-width:var(--max-width);margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--space-6);">
      <div>
        <p style="font-family:var(--font-heading);font-size:1.25rem;font-weight:800;color:var(--color-white);margin-bottom:8px;">Mapengo Innovations</p>
        <p style="font-size:.9rem;line-height:1.6;">Building South Africa's digital future — one system at a time.</p>
      </div>
      <div>
        <p style="font-weight:700;color:var(--color-white);margin-bottom:var(--space-2);font-size:.9rem;">Company</p>
        <nav style="display:flex;flex-direction:column;gap:8px;">
          <a href={`${base}about/`} style="color:rgba(255,255,255,.7);text-decoration:none;font-size:.9rem;">About</a>
          <a href={`${base}process/`} style="color:rgba(255,255,255,.7);text-decoration:none;font-size:.9rem;">Process</a>
          <a href={`${base}work/`} style="color:rgba(255,255,255,.7);text-decoration:none;font-size:.9rem;">Case Studies</a>
          <a href={`${base}blog/`} style="color:rgba(255,255,255,.7);text-decoration:none;font-size:.9rem;">Blog</a>
        </nav>
      </div>
      <div>
        <p style="font-weight:700;color:var(--color-white);margin-bottom:var(--space-2);font-size:.9rem;">Services</p>
        <nav style="display:flex;flex-direction:column;gap:8px;">
          <a href={`${base}solutions/web-development-south-africa/`} style="color:rgba(255,255,255,.7);text-decoration:none;font-size:.9rem;">Web Development SA</a>
          <a href={`${base}solutions/business-systems-south-africa/`} style="color:rgba(255,255,255,.7);text-decoration:none;font-size:.9rem;">Business Systems SA</a>
          <a href={`${base}solutions/custom-software-south-africa/`} style="color:rgba(255,255,255,.7);text-decoration:none;font-size:.9rem;">Custom Software SA</a>
          <a href={`${base}industries/`} style="color:rgba(255,255,255,.7);text-decoration:none;font-size:.9rem;">Industries</a>
        </nav>
      </div>
      <div>
        <p style="font-weight:700;color:var(--color-white);margin-bottom:var(--space-2);font-size:.9rem;">Legal</p>
        <nav style="display:flex;flex-direction:column;gap:8px;">
          <a href={`${base}legal/popia/`} style="color:rgba(255,255,255,.7);text-decoration:none;font-size:.9rem;">POPIA Compliance</a>
          <a href={`${base}legal/privacy/`} style="color:rgba(255,255,255,.7);text-decoration:none;font-size:.9rem;">Privacy Policy</a>
          <a href={`${base}legal/terms/`} style="color:rgba(255,255,255,.7);text-decoration:none;font-size:.9rem;">Terms of Service</a>
        </nav>
      </div>
    </div>
    <div style="max-width:var(--max-width);margin:var(--space-4) auto 0;border-top:1px solid rgba(255,255,255,.1);padding-top:var(--space-3);font-size:.85rem;">
      &copy; {new Date().getFullYear()} Mapengo Innovations (Pty) Ltd. All rights reserved. 🇿🇦 Proudly South African.
    </div>
  </footer>
</BaseLayout>
