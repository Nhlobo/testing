          <a href={`${base}pricing/`} style="color:rgba(255,255,255,.65);text-decoration:none;font-size:.9rem;" onmouseover="this.style.color='var(--color-accent)'" onmouseout="this.style.color='rgba(255,255,255,.65)'">Pricing</a>
          <a href={`${base}contact/`} style="color:rgba(255,255,255,.65);text-decoration:none;font-size:.9rem;" onmouseover="this.style.color='var(--color-accent)'" onmouseout="this.style.color='rgba(255,255,255,.65)'">Contact</a>
        </nav>
      </div>
      <!-- Services -->
      <div>
        <p style="font-weight:700;color:var(--color-white);margin-bottom:var(--space-2);font-size:.9rem;text-transform:uppercase;letter-spacing:1px;">Services</p>
        <nav style="display:flex;flex-direction:column;gap:10px;">
          <a href={`${base}solutions/web-development-south-africa/`} style="color:rgba(255,255,255,.65);text-decoration:none;font-size:.9rem;" onmouseover="this.style.color='var(--color-accent)'" onmouseout="this.style.color='rgba(255,255,255,.65)'">Web Development SA</a>
          <a href={`${base}solutions/business-systems-south-africa/`} style="color:rgba(255,255,255,.65);text-decoration:none;font-size:.9rem;" onmouseover="this.style.color='var(--color-accent)'" onmouseout="this.style.color='rgba(255,255,255,.65)'">Business Systems SA</a>
          <a href={`${base}solutions/custom-software-south-africa/`} style="color:rgba(255,255,255,.65);text-decoration:none;font-size:.9rem;" onmouseover="this.style.color='var(--color-accent)'" onmouseout="this.style.color='rgba(255,255,255,.65)'">Custom Software SA</a>
          <a href={`${base}services/mobile-apps/`} style="color:rgba(255,255,255,.65);text-decoration:none;font-size:.9rem;" onmouseover="this.style.color='var(--color-accent)'" onmouseout="this.style.color='rgba(255,255,255,.65)'">Mobile Apps</a>
