      <!-- Brand column -->
      <div>
        <a href={base} style="font-family:var(--font-heading);font-size:1.5rem;font-weight:800;color:var(--color-white);text-decoration:none;display:inline-block;margin-bottom:var(--space-2);">Mapengo<span style="color:var(--color-accent);">.</span></a>
