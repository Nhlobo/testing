---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---

<BaseLayout
  title="Business Systems South Africa — Custom Software for SA Businesses"
  description="We build custom business systems for South African companies — ERP, CRM, inventory, billing, automation, and more. SA-first design, fixed pricing, full ownership."
>
  <header style="background:var(--color-primary);color:var(--color-white);padding:var(--space-6) var(--space-4);">
    <nav style="max-width:var(--max-width);margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-2);">
      <a href={base} style="font-family:var(--font-heading);font-size:1.5rem;font-weight:800;color:var(--color-white);text-decoration:none;">Mapengo<span style="color:var(--color-accent);">.</span></a>
      <ul style="list-style:none;display:flex;gap:var(--space-3);margin:0;padding:0;flex-wrap:wrap;">
        <li><a href={`${base}services/`} style="color:var(--color-white);text-decoration:none;">Services</a></li>
        <li><a href={`${base}industries/`} style="color:var(--color-white);text-decoration:none;">Industries</a></li>
        <li><a href={`${base}pricing/`} style="color:var(--color-white);text-decoration:none;">Pricing</a></li>
        <li><a href={`${base}contact/`} style="background:var(--color-accent);color:var(--color-white);padding:8px 20px;border-radius:var(--radius-full);text-decoration:none;font-weight:600;">Get a Quote</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section style="background:var(--color-primary);color:var(--color-white);padding:var(--space-16) var(--space-4);text-align:center;">
      <p style="color:var(--color-accent);font-weight:600;letter-spacing:2px;text-transform:uppercase;font-size:.85rem;margin-bottom:var(--space-2);">Business Systems · South Africa</p>
      <h1 style="font-family:var(--font-heading);font-size:clamp(2rem,4.5vw,3.5rem);font-weight:800;line-height:1.1;margin-bottom:var(--space-3);max-width:800px;margin-left:auto;margin-right:auto;">
        The Business System Your SA Company Has Been Waiting For
      </h1>
      <p style="font-size:1.1rem;opacity:.85;max-width:680px;margin:0 auto var(--space-5);">
        Stop running your business on WhatsApp, spreadsheets, and paper. We build the integrated systems that let SA businesses operate like global enterprises — at SA prices.
      </p>
      <div style="display:flex;gap:var(--space-2);justify-content:center;flex-wrap:wrap;">
        <a href={`${base}contact/`} data-smart-cta style="background:var(--color-accent);color:var(--color-white);padding:14px 32px;border-radius:var(--radius-full);font-weight:700;text-decoration:none;">Book a Free Demo</a>
        <a href={`${base}industries/`} style="border:2px solid rgba(255,255,255,.3);color:var(--color-white);padding:14px 32px;border-radius:var(--radius-full);font-weight:600;text-decoration:none;">See by Industry</a>
      </div>
    </section>

    <!-- Pain Points -->
    <section style="padding:var(--space-12) var(--space-4);background:var(--color-grey-50);">
      <div style="max-width:var(--max-width);margin:0 auto;">
        <h2 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;color:var(--color-primary);text-align:center;margin-bottom:var(--space-2);">Sound Familiar?</h2>
        <p style="text-align:center;color:var(--color-grey-600);margin-bottom:var(--space-8);">These are the most common operational problems we solve for SA businesses.</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:var(--space-3);">
          {[
            { problem: 'You spend hours each week on manual data entry', solution: 'Automated capture from every touchpoint' },
            { problem: 'No single view of your customers, sales, or inventory', solution: 'Unified dashboard across all operations' },
            { problem: 'Cash flow surprises because invoices aren\'t tracked properly', solution: 'Automated invoice management and cash flow forecasting' },
            { problem: 'Team coordination happens in WhatsApp groups', solution: 'Structured workflow and task management' },
            { problem: 'No real-time visibility on what\'s happening in the business', solution: 'Live dashboards and alerts for every metric that matters' },
            { problem: 'Can\'t get a business loan because you have no financial records', solution: 'Automated financial reports for banks, SARS, and funders' },
          ].map(item => (
            <div style="background:var(--color-white);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm);">
              <div style="padding:var(--space-3);border-left:4px solid #e53e3e;">
                <p style="font-size:.85rem;font-weight:600;color:#e53e3e;margin-bottom:4px;">THE PROBLEM</p>
                <p style="color:var(--color-grey-800);font-size:.9rem;line-height:1.6;">{item.problem}</p>
              </div>
              <div style="padding:var(--space-3);border-left:4px solid var(--color-teal);background:var(--color-grey-50);">
                <p style="font-size:.85rem;font-weight:600;color:var(--color-teal);margin-bottom:4px;">OUR SOLUTION</p>
                <p style="color:var(--color-grey-800);font-size:.9rem;line-height:1.6;">{item.solution}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Systems we build -->
    <section style="padding:var(--space-12) var(--space-4);">
      <div style="max-width:var(--max-width);margin:0 auto;">
        <h2 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;color:var(--color-primary);text-align:center;margin-bottom:var(--space-8);">Systems We Build</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--space-3);">
          {[
            { icon: '🏢', title: 'ERP Systems', desc: 'Finance, HR, inventory, procurement in one integrated platform.' },
            { icon: '👥', title: 'CRM Platforms', desc: 'Manage leads, customers, and relationships at scale.' },
            { icon: '📦', title: 'Inventory Systems', desc: 'Real-time stock management across multiple locations.' },
            { icon: '💰', title: 'Billing & Invoicing', desc: 'Automated invoicing, payment tracking, and collections.' },
            { icon: '⚙️', title: 'Process Automation', desc: 'Eliminate repetitive manual tasks with workflow automation.' },
            { icon: '📊', title: 'BI Dashboards', desc: 'Real-time business intelligence for every department.' },
          ].map(s => (
            <div style="background:var(--color-grey-50);padding:var(--space-3);border-radius:var(--radius-lg);text-align:center;">
              <p style="font-size:2rem;margin-bottom:var(--space-1);">{s.icon}</p>
              <h3 style="font-family:var(--font-heading);font-size:1rem;font-weight:700;color:var(--color-primary);margin-bottom:6px;">{s.title}</h3>
              <p style="color:var(--color-grey-600);font-size:.85rem;line-height:1.5;">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="background:var(--color-accent);color:var(--color-white);padding:var(--space-12) var(--space-4);text-align:center;">
      <h2 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;margin-bottom:var(--space-2);">Let's Systematise Your Business</h2>
      <p style="opacity:.9;margin-bottom:var(--space-4);font-size:1.05rem;max-width:540px;margin-left:auto;margin-right:auto;">Book a free 45-minute discovery call. We'll map your current processes and show you exactly where systems can save you time and money.</p>
      <a href={`${base}contact/`} style="background:var(--color-white);color:var(--color-accent);padding:14px 36px;border-radius:var(--radius-full);font-weight:700;text-decoration:none;display:inline-block;">Book Free Discovery Call</a>
    </section>
  </main>

  <footer style="background:var(--color-primary);color:rgba(255,255,255,.7);padding:var(--space-6) var(--space-4);text-align:center;font-size:.9rem;">
    <p>&copy; {new Date().getFullYear()} Mapengo Innovations — <a href={`${base}legal/privacy/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Privacy</a> · <a href={`${base}legal/terms/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Terms</a></p>
  </footer>
</BaseLayout>
