---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---

<BaseLayout
  title="Web Development South Africa — Fast, Modern Websites for SA Businesses"
  description="Professional web development services in South Africa. We build fast, high-converting websites and web applications for businesses in Johannesburg, Cape Town, Durban and beyond."
>
  <header style="background:var(--color-primary);color:var(--color-white);padding:var(--space-6) var(--space-4);">
    <nav style="max-width:var(--max-width);margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-2);">
      <a href={base} style="font-family:var(--font-heading);font-size:1.5rem;font-weight:800;color:var(--color-white);text-decoration:none;">Mapengo<span style="color:var(--color-accent);">.</span></a>
      <ul style="list-style:none;display:flex;gap:var(--space-3);margin:0;padding:0;flex-wrap:wrap;">
        <li><a href={`${base}services/`} style="color:var(--color-white);text-decoration:none;">Services</a></li>
        <li><a href={`${base}industries/`} style="color:var(--color-white);text-decoration:none;">Industries</a></li>
        <li><a href={`${base}pricing/`} style="color:var(--color-white);text-decoration:none;">Pricing</a></li>
        <li><a href={`${base}contact/`} style="background:var(--color-accent);color:var(--color-white);padding:8px 20px;border-radius:var(--radius-full);text-decoration:none;font-weight:600;">Get a Quote</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section style="background:var(--color-primary);color:var(--color-white);padding:var(--space-16) var(--space-4);">
      <div style="max-width:var(--max-width);margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:var(--space-8);align-items:center;">
        <div>
          <p style="color:var(--color-accent);font-weight:600;letter-spacing:2px;text-transform:uppercase;font-size:.85rem;margin-bottom:var(--space-2);">Web Development · South Africa</p>
          <h1 style="font-family:var(--font-heading);font-size:clamp(2rem,4vw,3.25rem);font-weight:800;line-height:1.1;margin-bottom:var(--space-3);">
            Websites That Win<br/>in South Africa
          </h1>
          <p style="font-size:1.1rem;opacity:.85;line-height:1.7;margin-bottom:var(--space-5);">
            We build fast, beautiful, high-converting websites for South African businesses — optimised for local search, local users, and local success.
          </p>
          <div style="display:flex;gap:var(--space-2);flex-wrap:wrap;">
            <a href={`${base}contact/`} data-smart-cta style="background:var(--color-accent);color:var(--color-white);padding:14px 32px;border-radius:var(--radius-full);font-weight:700;text-decoration:none;">Get a Free Quote</a>
            <a href={`${base}work/`} style="border:2px solid rgba(255,255,255,.3);color:var(--color-white);padding:14px 32px;border-radius:var(--radius-full);font-weight:600;text-decoration:none;">See Our Work</a>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-2);">
          {[
            { value: '<1.5s', label: 'First Load' },
            { value: '95+', label: 'Lighthouse Score' },
            { value: '50+', label: 'Sites Launched' },
            { value: '100%', label: 'Mobile Ready' },
          ].map(s => (
            <div style="background:rgba(255,255,255,.08);padding:var(--space-3);border-radius:var(--radius-lg);text-align:center;">
              <p style="font-family:var(--font-heading);font-size:1.75rem;font-weight:800;color:var(--color-accent);">{s.value}</p>
              <p style="font-size:.8rem;opacity:.75;">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What you get -->
    <section style="padding:var(--space-12) var(--space-4);background:var(--color-grey-50);">
      <div style="max-width:var(--max-width);margin:0 auto;">
        <h2 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;color:var(--color-primary);text-align:center;margin-bottom:var(--space-2);">What You Get</h2>
        <p style="text-align:center;color:var(--color-grey-600);margin-bottom:var(--space-8);">Every website we build includes these as standard.</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:var(--space-3);">
          {[
            { icon: '⚡', title: 'Ultra-Fast Loading', desc: 'Sub-1.5 second loads. Optimised images. Zero-blocking scripts. CDN delivery.' },
            { icon: '📱', title: 'Mobile-First Design', desc: 'Built for South African mobile users first. Works on any device, any screen size.' },
            { icon: '🔍', title: 'SA-Optimised SEO', desc: 'Structured for South African search. Rank for local keywords from day one.' },
            { icon: '🔒', title: 'Secure & Compliant', desc: 'HTTPS, POPIA-compliant forms, spam protection, and regular security updates.' },
            { icon: '📊', title: 'Analytics Ready', desc: 'Understand your visitors, track conversions, and make data-driven decisions.' },
            { icon: '🔧', title: 'Easy to Manage', desc: 'Update your own content without a developer. We build CMS-ready.' },
          ].map(f => (
            <div style="background:var(--color-white);padding:var(--space-3);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);">
              <p style="font-size:1.75rem;margin-bottom:var(--space-1);">{f.icon}</p>
              <h3 style="font-family:var(--font-heading);font-size:1.05rem;font-weight:700;color:var(--color-primary);margin-bottom:6px;">{f.title}</h3>
              <p style="color:var(--color-grey-600);font-size:.9rem;line-height:1.6;">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Pricing preview -->
    <section style="padding:var(--space-12) var(--space-4);">
      <div style="max-width:var(--max-width);margin:0 auto;text-align:center;">
        <h2 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;color:var(--color-primary);margin-bottom:var(--space-2);">Web Development Pricing</h2>
        <p style="color:var(--color-grey-600);margin-bottom:var(--space-8);">Transparent, once-off pricing for South African businesses.</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:var(--space-3);align-items:start;">
          {[
            { name: 'Starter Site', price: 'R 8,500', desc: '5 pages, contact form, mobile-ready, SEO basics', badge: '' },
            { name: 'Business Site', price: 'R 24,000', desc: '15 pages, CMS, blog, analytics, SEO optimised', badge: 'Most Popular' },
            { name: 'Web Application', price: 'R 45,000+', desc: 'Custom functionality, user management, integrations', badge: '' },
          ].map(p => (
            <div style={`background:${p.badge ? 'var(--color-accent)' : 'var(--color-grey-50)'};color:${p.badge ? 'var(--color-white)' : 'var(--color-primary)'};padding:var(--space-4);border-radius:var(--radius-lg);position:relative;`}>
              {p.badge && <span style="position:absolute;top:-10px;left:50%;transform:translateX(-50%);background:var(--color-teal);color:var(--color-white);font-size:.75rem;font-weight:700;padding:4px 14px;border-radius:var(--radius-full);">{p.badge}</span>}
              <h3 style="font-family:var(--font-heading);font-size:1.15rem;font-weight:700;margin-bottom:8px;">{p.name}</h3>
              <p style={`font-family:var(--font-heading);font-size:2rem;font-weight:800;${p.badge ? '' : 'color:var(--color-accent);'}`}>{p.price}</p>
              <p style={`font-size:.9rem;margin:var(--space-2) 0 var(--space-3);${p.badge ? 'opacity:.9;' : 'color:var(--color-grey-600);'}`}>{p.desc}</p>
              <a href={`${base}contact/`} style={`display:block;text-align:center;padding:10px 20px;border-radius:var(--radius-full);font-weight:700;text-decoration:none;background:${p.badge ? 'var(--color-white)' : 'var(--color-accent)'};color:${p.badge ? 'var(--color-accent)' : 'var(--color-white)'};font-size:.9rem;`}>Get a Quote</a>
            </div>
          ))}
        </div>
        <a href={`${base}pricing/`} style="display:inline-block;margin-top:var(--space-4);color:var(--color-accent);font-weight:600;text-decoration:none;">View full pricing →</a>
      </div>
    </section>

    <!-- FAQ -->
    <section style="padding:var(--space-12) var(--space-4);background:var(--color-grey-50);">
      <div style="max-width:720px;margin:0 auto;">
        <h2 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;color:var(--color-primary);text-align:center;margin-bottom:var(--space-6);">Common Questions</h2>
        <div style="display:flex;flex-direction:column;gap:var(--space-2);">
          {[
            { q: 'How long does a website take to build?', a: 'A basic 5-page site takes 2–3 weeks. A full business site with CMS takes 4–6 weeks. We give you a fixed timeline before we start.' },
            { q: 'Will my website rank on Google in South Africa?', a: 'Yes. We build every site with SA-specific SEO: local keyword targeting, Google Business integration, fast load times (a ranking factor), and structured data.' },
            { q: 'Can I update the website myself?', a: 'Yes. We build with a simple content management system so you can update text, images, and content without touching code.' },
            { q: 'Do you offer hosting?', a: 'Yes. We offer managed hosting on South African and CDN nodes. Starts at R650/month including security updates and daily backups.' },
          ].map(faq => (
            <details style="background:var(--color-white);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;">
              <summary style="padding:var(--space-3) var(--space-4);font-family:var(--font-heading);font-weight:700;color:var(--color-primary);cursor:pointer;font-size:.95rem;">{faq.q}</summary>
              <p style="padding:0 var(--space-4) var(--space-3);color:var(--color-grey-800);font-size:.9rem;line-height:1.7;">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="background:var(--color-accent);color:var(--color-white);padding:var(--space-12) var(--space-4);text-align:center;">
      <h2 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;margin-bottom:var(--space-2);">Ready for a World-Class South African Website?</h2>
      <p style="opacity:.9;margin-bottom:var(--space-4);font-size:1.05rem;">Free consultation. Fixed prices. No surprises.</p>
      <a href={`${base}contact/`} style="background:var(--color-white);color:var(--color-accent);padding:14px 36px;border-radius:var(--radius-full);font-weight:700;text-decoration:none;display:inline-block;">Get Your Free Quote Today</a>
    </section>
  </main>

  <footer style="background:var(--color-primary);color:rgba(255,255,255,.7);padding:var(--space-6) var(--space-4);text-align:center;font-size:.9rem;">
    <p>&copy; {new Date().getFullYear()} Mapengo Innovations — <a href={`${base}legal/privacy/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Privacy</a> · <a href={`${base}legal/terms/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Terms</a></p>
  </footer>
</BaseLayout>

<style>
  @media (max-width: 768px) {
    section > div[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
