---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const caseStudies = await getCollection('caseStudies');
  return caseStudies.map(cs => ({
    params: { slug: cs.id.replace(/\.mdx?$/, '') },
    props: { cs },
  }));
}

const { cs } = Astro.props;
const { Content } = await render(cs);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={cs.data.title}
  description={`${cs.data.client} — ${cs.data.category} case study by Mapengo Innovations`}
>
  <header style="background:var(--color-primary);color:var(--color-white);padding:var(--space-6) var(--space-4);">
    <nav style="max-width:var(--max-width);margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-2);">
      <a href={base} style="font-family:var(--font-heading);font-size:1.5rem;font-weight:800;color:var(--color-white);text-decoration:none;">Mapengo<span style="color:var(--color-accent);">.</span></a>
      <ul style="list-style:none;display:flex;gap:var(--space-3);margin:0;padding:0;flex-wrap:wrap;">
        <li><a href={`${base}services/`} style="color:var(--color-white);text-decoration:none;">Services</a></li>
        <li><a href={`${base}work/`} style="color:var(--color-accent);text-decoration:none;font-weight:600;">Work</a></li>
        <li><a href={`${base}contact/`} style="background:var(--color-accent);color:var(--color-white);padding:8px 20px;border-radius:var(--radius-full);text-decoration:none;font-weight:600;">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section style="background:var(--color-primary);color:var(--color-white);padding:var(--space-12) var(--space-4);">
      <div style="max-width:900px;margin:0 auto;">
        <a href={`${base}work/`} style="color:var(--color-accent);text-decoration:none;font-size:.9rem;">← All Case Studies</a>
        <div style="margin-top:var(--space-3);display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:var(--space-4);">
          <div>
            <span style="display:inline-block;background:rgba(255,255,255,.15);font-size:.8rem;font-weight:600;padding:4px 12px;border-radius:var(--radius-full);margin-bottom:var(--space-2);">{cs.data.category}</span>
            <h1 style="font-family:var(--font-heading);font-size:clamp(1.75rem,4vw,2.75rem);font-weight:800;line-height:1.2;margin-bottom:8px;">{cs.data.title}</h1>
            <p style="opacity:.8;">{cs.data.client} · {cs.data.year}</p>
          </div>
          <div style="display:flex;gap:var(--space-4);flex-wrap:wrap;">
            {cs.data.metrics.map(m => (
              <div style="text-align:center;">
                <div style="font-family:var(--font-heading);font-size:2rem;font-weight:800;color:var(--color-accent);">{m.value}</div>
                <div style="font-size:.8rem;opacity:.75;">{m.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section style="padding:var(--space-10) var(--space-4);">
      <div style="max-width:900px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr;gap:var(--space-6);align-items:start;">
        <div class="prose">
          <Content />
        </div>
        <aside>
          <div style="background:var(--color-grey-50);padding:var(--space-4);border-radius:var(--radius-lg);margin-bottom:var(--space-3);">
            <h3 style="font-family:var(--font-heading);font-size:1rem;font-weight:700;color:var(--color-primary);margin-bottom:var(--space-2);">Tech Stack</h3>
            <div style="display:flex;flex-wrap:wrap;gap:6px;">
              {cs.data.stack.map(t => (
                <span style="background:var(--color-white);border:1px solid var(--color-grey-200);font-size:.8rem;padding:4px 10px;border-radius:var(--radius-full);">{t}</span>
              ))}
            </div>
          </div>
          <a href={`${base}contact/`} style="display:block;text-align:center;background:var(--color-accent);color:var(--color-white);padding:12px 24px;border-radius:var(--radius-full);font-weight:700;text-decoration:none;">Start a Similar Project</a>
        </aside>
      </div>
    </section>
  </main>

  <footer style="background:var(--color-primary);color:rgba(255,255,255,.7);padding:var(--space-6) var(--space-4);text-align:center;font-size:.9rem;">
    <p>&copy; {new Date().getFullYear()} Mapengo Innovations — <a href={`${base}legal/privacy/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Privacy</a> · <a href={`${base}legal/terms/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Terms</a></p>
  </footer>
</BaseLayout>

<style>
  .prose :global(h2), .prose :global(h3) {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-primary);
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
  }
  .prose :global(p) { line-height: 1.8; color: #374151; margin-bottom: var(--space-3); }
  .prose :global(ul) { padding-left: var(--space-4); margin-bottom: var(--space-3); }
  .prose :global(li) { line-height: 1.7; color: #374151; margin-bottom: 4px; }
  .prose :global(strong) { color: var(--color-primary); }
</style>
