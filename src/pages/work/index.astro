---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
const caseStudies = (await getCollection('caseStudies')).sort(
  (a, b) => b.data.year - a.data.year
);
---

<BaseLayout
  title="Our Work"
  description="Case studies and portfolio — see how we've helped South African businesses transform digitally."
>
  <header style="background:var(--color-primary);color:var(--color-white);padding:var(--space-3) var(--space-4);position:sticky;top:0;z-index:500;box-shadow:0 2px 12px rgba(0,0,0,.25);">
    <nav style="max-width:var(--max-width);margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-2);">
      <a href={base} style="font-family:var(--font-heading);font-size:1.5rem;font-weight:800;color:var(--color-white);text-decoration:none;flex-shrink:0;">Mapengo<span style="color:var(--color-accent);">.</span></a>
      <ul style="list-style:none;display:flex;gap:var(--space-3);margin:0;padding:0;flex-wrap:wrap;align-items:center;">
        <li><a href={`${base}services/`} style="color:rgba(255,255,255,.8);text-decoration:none;font-size:.9375rem;">Services</a></li>
        <li><a href={`${base}industries/`} style="color:rgba(255,255,255,.8);text-decoration:none;font-size:.9375rem;">Industries</a></li>
        <li><a href={`${base}case-studies/`} style="color:rgba(255,255,255,.8);text-decoration:none;font-size:.9375rem;">Case Studies</a></li>
        <li><a href={`${base}work/`} style="color:var(--color-white);font-weight:700;border-bottom:2px solid var(--color-accent);padding-bottom:2px;text-decoration:none;font-size:.9375rem;">Work</a></li>
        <li><a href={`${base}about/`} style="color:rgba(255,255,255,.8);text-decoration:none;font-size:.9375rem;">About</a></li>
        <li><a href={`${base}blog/`} style="color:rgba(255,255,255,.8);text-decoration:none;font-size:.9375rem;">Blog</a></li>
        <li><a href={`${base}contact/`} style="background:var(--color-accent);color:var(--color-white);padding:9px 22px;border-radius:var(--radius-full);font-weight:700;font-size:.875rem;text-decoration:none;">Get Quote</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section style="background:var(--color-primary);color:var(--color-white);padding:var(--space-12) var(--space-4);text-align:center;">
      <h1 style="font-family:var(--font-heading);font-size:3rem;font-weight:800;margin-bottom:var(--space-2);">Our Work</h1>
      <p style="opacity:.8;font-size:1.1rem;">Real projects, real results for South African businesses.</p>
    </section>

    <section style="padding:var(--space-12) var(--space-4);background:var(--color-grey-50);">
      <div style="max-width:var(--max-width);margin:0 auto;display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:var(--space-4);">
        {caseStudies.map(cs => {
          const slug = cs.id.replace(/\.mdx?$/, '');
          return (
            <a href={`${base}work/${slug}/`} style="background:var(--color-white);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm);text-decoration:none;display:flex;flex-direction:column;">
              <div style="padding:var(--space-4);flex:1;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-2);">
                  <span style="background:var(--color-grey-100);color:var(--color-grey-600);font-size:.8rem;font-weight:600;padding:4px 12px;border-radius:var(--radius-full);">{cs.data.category}</span>
                  <span style="font-size:.85rem;color:var(--color-grey-600);">{cs.data.year}</span>
                </div>
                <h2 style="font-family:var(--font-heading);font-size:1.15rem;font-weight:700;color:var(--color-primary);margin-bottom:6px;line-height:1.3;">{cs.data.title}</h2>
                <p style="color:var(--color-grey-600);font-size:.85rem;margin-bottom:var(--space-3);">{cs.data.client}</p>
                <div style="display:flex;flex-wrap:wrap;gap:var(--space-3);">
                  {cs.data.metrics.slice(0, 3).map(m => (
                    <div>
                      <div style="font-family:var(--font-heading);font-size:1.1rem;font-weight:800;color:var(--color-accent);">{m.value}</div>
                      <div style="font-size:.75rem;color:var(--color-grey-600);">{m.label}</div>
                    </div>
                  ))}
                </div>
              </div>
              <div style="padding:var(--space-2) var(--space-4);border-top:1px solid var(--color-grey-100);display:flex;flex-wrap:wrap;gap:6px;">
                {cs.data.stack.slice(0, 4).map(t => (
                  <span style="background:var(--color-grey-100);font-size:.75rem;color:var(--color-grey-600);padding:2px 8px;border-radius:var(--radius-full);">{t}</span>
                ))}
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </main>

  <footer style="background:var(--color-primary);color:rgba(255,255,255,.7);padding:var(--space-6) var(--space-4);text-align:center;font-size:.9rem;">
    <p>&copy; {new Date().getFullYear()} Mapengo Innovations — <a href={`${base}legal/privacy/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Privacy</a> · <a href={`${base}legal/terms/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Terms</a></p>
  </footer>
</BaseLayout>
