---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
const solutions = (await getCollection('solutions')).sort(
  (a, b) => a.data.order - b.data.order
);

const coreServiceSlugs = ['web-development', 'mobile-apps', 'systems-integration', 'ui-ux-design'];
const coreServices = solutions.filter(s => coreServiceSlugs.includes(s.data.slug));
const additionalServices = solutions.filter(s => !coreServiceSlugs.includes(s.data.slug));
---

<BaseLayout
  title="Services — Web, Mobile, Business Systems & Design"
  description="Enterprise-grade web development, mobile apps, custom business systems, and UI/UX design for South African businesses. Transparent ZAR pricing. POPIA compliant."
>
  <header style="background:var(--color-primary);color:var(--color-white);padding:var(--space-3) var(--space-4);position:sticky;top:0;z-index:500;box-shadow:0 2px 12px rgba(0,0,0,.25);">
    <nav style="max-width:var(--max-width);margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-2);">
      <a href={base} style="font-family:var(--font-heading);font-size:1.5rem;font-weight:800;color:var(--color-white);text-decoration:none;flex-shrink:0;">Mapengo<span style="color:var(--color-accent);">.</span></a>
      <ul style="list-style:none;display:flex;gap:var(--space-3);margin:0;padding:0;flex-wrap:wrap;align-items:center;">
        <li><a href={`${base}services/`} style="color:var(--color-white);font-weight:700;border-bottom:2px solid var(--color-accent);padding-bottom:2px;text-decoration:none;font-size:.9375rem;">Services</a></li>
        <li><a href={`${base}industries/`} style="color:rgba(255,255,255,.8);text-decoration:none;font-size:.9375rem;">Industries</a></li>
        <li><a href={`${base}case-studies/`} style="color:rgba(255,255,255,.8);text-decoration:none;font-size:.9375rem;">Case Studies</a></li>
        <li><a href={`${base}work/`} style="color:rgba(255,255,255,.8);text-decoration:none;font-size:.9375rem;">Work</a></li>
        <li><a href={`${base}about/`} style="color:rgba(255,255,255,.8);text-decoration:none;font-size:.9375rem;">About</a></li>
        <li><a href={`${base}blog/`} style="color:rgba(255,255,255,.8);text-decoration:none;font-size:.9375rem;">Blog</a></li>
        <li><a href={`${base}contact/`} style="background:var(--color-accent);color:var(--color-white);padding:9px 22px;border-radius:var(--radius-full);font-weight:700;font-size:.875rem;text-decoration:none;">Get Quote</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section style="background:var(--color-primary);color:var(--color-white);padding:var(--space-16) var(--space-4) var(--space-12);text-align:center;position:relative;overflow:hidden;">
      <div style="position:absolute;top:-100px;right:-100px;width:500px;height:500px;background:radial-gradient(circle,rgba(255,107,53,.12) 0%,transparent 70%);pointer-events:none;" aria-hidden="true"></div>
      <div style="max-width:780px;margin:0 auto;position:relative;">
        <p style="color:var(--color-accent);font-weight:700;letter-spacing:3px;text-transform:uppercase;margin-bottom:var(--space-2);font-size:.8rem;">What We Do</p>
        <h1 style="font-family:var(--font-heading);font-size:clamp(2.5rem,5.5vw,3.75rem);font-weight:800;line-height:1.1;margin-bottom:var(--space-4);">
          Services Built to <span style="color:var(--color-accent);">Close Deals</span>
        </h1>
        <p style="font-size:1.15rem;opacity:.85;max-width:620px;margin:0 auto var(--space-6);line-height:1.7;">
          We don't build websites. We build digital business engines — high-performance platforms engineered to attract, convert, and retain clients for South African businesses.
        </p>
        <div style="display:flex;gap:var(--space-2);justify-content:center;flex-wrap:wrap;">
          <a href={`${base}contact/`} data-analytics-cta="services-hero-quote" style="background:var(--color-accent);color:var(--color-white);padding:14px 36px;border-radius:var(--radius-full);font-weight:700;font-size:1rem;text-decoration:none;box-shadow:0 4px 20px rgba(255,107,53,.35);">Get a Free Quote</a>
          <a href={`${base}work/`} style="border:2px solid rgba(255,255,255,.3);color:var(--color-white);padding:14px 36px;border-radius:var(--radius-full);font-weight:600;font-size:1rem;text-decoration:none;">View Our Work</a>
        </div>
      </div>
    </section>

    <!-- Stats bar -->
    <section style="background:var(--color-accent);color:var(--color-white);padding:var(--space-4) var(--space-4);">
      <div style="max-width:var(--max-width);margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-3);text-align:center;">
        {[
          { v: '50+', l: 'Projects Delivered' },
          { v: '<2s', l: 'Target Load Time' },
          { v: '96', l: 'Avg Lighthouse Score' },
          { v: '98%', l: 'Client Satisfaction' },
        ].map(s => (
          <div>
            <p style="font-family:var(--font-heading);font-size:1.75rem;font-weight:800;margin:0 0 4px;">{s.v}</p>
            <p style="opacity:.85;font-size:.78rem;font-weight:500;text-transform:uppercase;letter-spacing:.5px;margin:0;">{s.l}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Core Services -->
    <section style="padding:var(--space-12) var(--space-4);background:var(--color-grey-50);" id="core-services">
      <div style="max-width:var(--max-width);margin:0 auto;">
        <div style="text-align:center;margin-bottom:var(--space-10);">
          <p style="color:var(--color-accent);font-weight:700;letter-spacing:2px;text-transform:uppercase;font-size:.8rem;margin-bottom:var(--space-1);">Core Capabilities</p>
          <h2 style="font-family:var(--font-heading);font-size:clamp(1.75rem,4vw,2.5rem);font-weight:800;color:var(--color-primary);margin-bottom:var(--space-2);">Four Services. One Team. One Invoice.</h2>
          <p style="color:var(--color-grey-600);max-width:560px;margin:0 auto;font-size:1.05rem;">No juggling agencies. Strategy, design, development, and delivery under one roof — with a single point of accountability.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--space-4);">
          {coreServices.map((s, i) => (
            <a
              href={`${base}services/${s.data.slug}/`}
              style={`background:var(--color-white);padding:var(--space-5);border-radius:var(--radius-xl);box-shadow:var(--shadow-md);text-decoration:none;display:flex;flex-direction:column;gap:var(--space-2);border-top:4px solid ${i === 0 ? 'var(--color-accent)' : i === 1 ? 'var(--color-teal)' : i === 2 ? '#1A3A6B' : 'var(--color-accent)'};transition:transform .2s,box-shadow .2s;`}
              onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='var(--shadow-lg)'"
              onmouseout="this.style.transform='none';this.style.boxShadow='var(--shadow-md)'"
            >
              <div style="font-size:2.5rem;">{s.data.icon}</div>
              <h2 style="font-family:var(--font-heading);font-size:1.3rem;font-weight:800;color:var(--color-primary);line-height:1.2;">{s.data.title}</h2>
              <p style="color:var(--color-grey-600);font-size:.9rem;line-height:1.65;flex:1;">{s.data.description}</p>
              <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:var(--space-2);">
                {s.data.features.slice(0,4).map(f => (
                  <span style="background:var(--color-grey-100);color:var(--color-grey-600);font-size:.72rem;padding:3px 10px;border-radius:var(--radius-full);">{f}</span>
                ))}
              </div>
              <span style="color:var(--color-accent);font-weight:700;font-size:.9rem;">Explore service →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Additional Services -->
    {additionalServices.length > 0 && (
      <section style="padding:var(--space-12) var(--space-4);">
        <div style="max-width:var(--max-width);margin:0 auto;">
          <div style="text-align:center;margin-bottom:var(--space-8);">
            <p style="color:var(--color-accent);font-weight:700;letter-spacing:2px;text-transform:uppercase;font-size:.8rem;margin-bottom:var(--space-1);">Complete Delivery</p>
            <h2 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;color:var(--color-primary);">End-to-End — From Strategy to Support</h2>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--space-3);">
            {additionalServices.map(s => (
              <a href={`${base}services/${s.data.slug}/`} style="background:var(--color-white);padding:var(--space-4);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);text-decoration:none;display:flex;align-items:flex-start;gap:var(--space-3);border:1px solid var(--color-grey-200);transition:box-shadow .2s;"
                onmouseover="this.style.boxShadow='var(--shadow-md)'"
                onmouseout="this.style.boxShadow='var(--shadow-sm)'"
              >
                <span style="font-size:2rem;flex-shrink:0;">{s.data.icon}</span>
                <div>
                  <h3 style="font-family:var(--font-heading);font-size:1.05rem;font-weight:700;color:var(--color-primary);margin-bottom:6px;">{s.data.title}</h3>
                  <p style="color:var(--color-grey-600);font-size:.875rem;line-height:1.6;">{s.data.description}</p>
                  <span style="display:inline-block;margin-top:8px;color:var(--color-accent);font-size:.85rem;font-weight:600;">Learn more →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Why Mapengo -->
    <section style="padding:var(--space-12) var(--space-4);background:var(--color-grey-50);">
      <div style="max-width:var(--max-width);margin:0 auto;">
        <p style="text-align:center;color:var(--color-accent);font-weight:600;letter-spacing:2px;text-transform:uppercase;font-size:.85rem;margin-bottom:var(--space-2);">Why Choose Us</p>
        <h2 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;color:var(--color-primary);text-align:center;margin-bottom:var(--space-8);">Why South African Businesses Choose Mapengo</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:var(--space-4);">
          {[
            { icon: '🇿🇦', title: 'Built for South Africa', desc: 'Every solution is engineered with SA realities in mind: load shedding resilience, slow-network optimisation, POPIA compliance, and support for local payment methods like PayFast, Yoco, and Ozow.' },
            { icon: '📦', title: 'End-to-End Ownership', desc: 'Strategy, design, development, testing, deployment, and ongoing support. One accountable partner — not a chain of contractors passing blame.' },
            { icon: '📈', title: 'Results, Not Deliverables', desc: 'We measure success by your business outcomes — increased revenue, reduced costs, and happier customers — not feature checklists or go-live dates.' },
            { icon: '💰', title: 'Transparent ZAR Pricing', desc: 'No hidden international fees, no surprise invoices. Clear milestones, fixed-price options, and ZAR-denominated proposals so your budget is never a mystery.' },
          ].map(v => (
            <div style="background:var(--color-white);padding:var(--space-5);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);border-left:4px solid var(--color-accent);">
              <p style="font-size:2rem;margin-bottom:var(--space-2);">{v.icon}</p>
              <h3 style="font-family:var(--font-heading);font-size:1.1rem;font-weight:700;color:var(--color-primary);margin-bottom:8px;">{v.title}</h3>
              <p style="color:var(--color-grey-600);font-size:.9rem;line-height:1.65;">{v.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process in Brief -->
    <section style="padding:var(--space-12) var(--space-4);">
      <div style="max-width:var(--max-width);margin:0 auto;">
        <p style="text-align:center;color:var(--color-accent);font-weight:600;letter-spacing:2px;text-transform:uppercase;font-size:.85rem;margin-bottom:var(--space-2);">How We Work</p>
        <h2 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;color:var(--color-primary);text-align:center;margin-bottom:var(--space-8);">Predictable Process. No Surprises.</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--space-4);">
          {[
            { step: '01', title: 'Discover', icon: '🔍', desc: 'Deep-dive workshops to understand your business, users, and goals before a single line of code is written.' },
            { step: '02', title: 'Design', icon: '✏️', desc: 'Wireframes and interactive prototypes reviewed with your team. We align on the solution before building it.' },
            { step: '03', title: 'Build', icon: '⚙️', desc: 'Agile sprints with weekly demos. You see progress at every stage — no black-box surprises at launch.' },
            { step: '04', title: 'Launch & Grow', icon: '🚀', desc: 'Smooth go-live with post-launch monitoring. We stay on to optimise and add features as you scale.' },
          ].map(p => (
            <div style="background:var(--color-white);padding:var(--space-5);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);position:relative;text-align:center;">
              <div style="font-family:var(--font-heading);font-size:3.5rem;font-weight:800;color:var(--color-grey-100);line-height:1;margin-bottom:var(--space-1);">{p.step}</div>
              <div style="font-size:1.75rem;margin-bottom:var(--space-2);">{p.icon}</div>
              <h3 style="font-family:var(--font-heading);font-size:1.05rem;font-weight:700;color:var(--color-primary);margin-bottom:8px;">{p.title}</h3>
              <p style="color:var(--color-grey-600);font-size:.875rem;line-height:1.65;">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="background:linear-gradient(135deg,var(--color-primary) 0%,#1A3A6B 100%);color:var(--color-white);padding:var(--space-12) var(--space-4);text-align:center;">
      <div style="max-width:640px;margin:0 auto;">
        <p style="color:var(--color-accent);font-weight:700;letter-spacing:2px;text-transform:uppercase;font-size:.8rem;margin-bottom:var(--space-2);">Get Started</p>
        <h2 style="font-family:var(--font-heading);font-size:clamp(1.75rem,4vw,2.5rem);font-weight:800;margin-bottom:var(--space-3);">Ready to Build Something That Works?</h2>
        <p style="opacity:.8;font-size:1.05rem;margin-bottom:var(--space-6);line-height:1.7;">Tell us about your project and we'll get back to you within one business day with a tailored proposal and transparent ZAR pricing.</p>
        <div style="display:flex;gap:var(--space-2);justify-content:center;flex-wrap:wrap;">
          <a href={`${base}contact/`} data-analytics-cta="services-bottom-quote" style="background:var(--color-accent);color:var(--color-white);padding:14px 36px;border-radius:var(--radius-full);font-weight:700;font-size:1rem;text-decoration:none;box-shadow:0 4px 20px rgba(255,107,53,.3);">Get a Free Quote</a>
          <a href={`${base}case-studies/`} style="border:2px solid rgba(255,255,255,.3);color:var(--color-white);padding:14px 36px;border-radius:var(--radius-full);font-weight:600;font-size:1rem;text-decoration:none;">See Case Studies</a>
        </div>
      </div>
    </section>
  </main>

  <footer style="background:var(--color-primary);color:rgba(255,255,255,.7);padding:var(--space-6) var(--space-4);text-align:center;font-size:.9rem;">
    <p>&copy; {new Date().getFullYear()} Mapengo Innovations — <a href={`${base}legal/privacy/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Privacy</a> · <a href={`${base}legal/terms/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Terms</a></p>
  </footer>
</BaseLayout>
