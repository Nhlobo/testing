---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const solutions = await getCollection('solutions');
  return solutions.map(s => ({
    params: { slug: s.data.slug },
    props: { solution: s },
  }));
}

const { solution } = Astro.props;
const { Content } = await render(solution);
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";

const accentMap: Record<string, string> = {
  'web-development': 'var(--color-accent)',
  'mobile-apps': 'var(--color-teal)',
  'ui-ux-design': '#8B5CF6',
  'systems-integration': '#1A3A6B',
};
const accent = accentMap[solution.data.slug] || 'var(--color-accent)';
---

<BaseLayout
  title={`${solution.data.title} — South Africa`}
  description={solution.data.description}
>
  <header style="background:var(--color-primary);color:var(--color-white);padding:var(--space-3) var(--space-4);position:sticky;top:0;z-index:500;box-shadow:0 2px 12px rgba(0,0,0,.25);">
    <nav style="max-width:var(--max-width);margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-2);">
      <a href={base} style="font-family:var(--font-heading);font-size:1.5rem;font-weight:800;color:var(--color-white);text-decoration:none;flex-shrink:0;">Mapengo<span style="color:var(--color-accent);">.</span></a>
      <ul style="list-style:none;display:flex;gap:var(--space-3);margin:0;padding:0;flex-wrap:wrap;align-items:center;">
        <li><a href={`${base}services/`} style="color:var(--color-accent);font-weight:700;text-decoration:none;font-size:.9375rem;">Services</a></li>
        <li><a href={`${base}industries/`} style="color:rgba(255,255,255,.8);text-decoration:none;font-size:.9375rem;">Industries</a></li>
        <li><a href={`${base}case-studies/`} style="color:rgba(255,255,255,.8);text-decoration:none;font-size:.9375rem;">Case Studies</a></li>
        <li><a href={`${base}about/`} style="color:rgba(255,255,255,.8);text-decoration:none;font-size:.9375rem;">About</a></li>
        <li><a href={`${base}contact/`} style="background:var(--color-accent);color:var(--color-white);padding:9px 22px;border-radius:var(--radius-full);font-weight:700;font-size:.875rem;text-decoration:none;">Get Quote</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section style="background:var(--color-primary);color:var(--color-white);padding:var(--space-16) var(--space-4) var(--space-12);position:relative;overflow:hidden;">
      <div style={`position:absolute;top:-80px;right:-80px;width:500px;height:500px;background:radial-gradient(circle,${accent}22 0%,transparent 70%);pointer-events:none;`} aria-hidden="true"></div>
      <div style="max-width:var(--max-width);margin:0 auto;position:relative;">
        <a href={`${base}services/`} style="color:rgba(255,255,255,.6);text-decoration:none;font-size:.9rem;display:inline-flex;align-items:center;gap:6px;margin-bottom:var(--space-4);">← All Services</a>
        <div style="max-width:760px;">
          <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.08);padding:6px 16px;border-radius:var(--radius-full);font-size:.8rem;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:rgba(255,255,255,.7);margin-bottom:var(--space-3);border:1px solid rgba(255,255,255,.12);">
            {solution.data.category}
          </div>
          <h1 style="font-family:var(--font-heading);font-size:clamp(2.25rem,5vw,3.5rem);font-weight:800;line-height:1.1;margin-bottom:var(--space-3);">{solution.data.title}</h1>
          <p style="font-size:1.2rem;opacity:.85;line-height:1.7;margin-bottom:var(--space-5);">{solution.data.description}</p>
          <div style="display:flex;gap:var(--space-2);flex-wrap:wrap;">
            <a href={`${base}contact/`} data-analytics-cta={`service-${solution.data.slug}-quote`} style={`background:${accent};color:var(--color-white);padding:13px 32px;border-radius:var(--radius-full);font-weight:700;font-size:1rem;text-decoration:none;box-shadow:0 4px 16px rgba(0,0,0,.2);`}>Get a Quote</a>
            <a href={`${base}case-studies/`} style="border:2px solid rgba(255,255,255,.3);color:var(--color-white);padding:13px 32px;border-radius:var(--radius-full);font-weight:600;font-size:1rem;text-decoration:none;">See Our Work</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Feature pills -->
    <section style={`background:${accent};color:var(--color-white);padding:var(--space-3) var(--space-4);`}>
      <div style="max-width:var(--max-width);margin:0 auto;display:flex;flex-wrap:wrap;gap:var(--space-2);align-items:center;justify-content:center;">
        {solution.data.features.map(f => (
          <span style="background:rgba(255,255,255,.15);padding:6px 16px;border-radius:var(--radius-full);font-size:.85rem;font-weight:600;letter-spacing:.3px;">{f}</span>
        ))}
      </div>
    </section>

    <!-- Content + sidebar -->
    <section style="padding:var(--space-12) var(--space-4);">
      <div style="max-width:var(--max-width);margin:0 auto;display:grid;grid-template-columns:2fr 1fr;gap:var(--space-8);align-items:start;">
        <article class="prose">
          <Content />
        </article>

        <aside>
          <div style="background:var(--color-grey-50);padding:var(--space-4);border-radius:var(--radius-xl);margin-bottom:var(--space-4);border:1px solid var(--color-grey-200);">
            <h3 style="font-family:var(--font-heading);font-size:1rem;font-weight:800;color:var(--color-primary);margin-bottom:var(--space-3);">Key Deliverables</h3>
            <ul style="list-style:none;padding:0;margin:0 0 var(--space-4);">
              {solution.data.features.map(f => (
                <li style={`padding:10px 0;border-bottom:1px solid var(--color-grey-200);display:flex;gap:10px;align-items:center;font-size:.9rem;color:var(--color-primary);`}>
                  <span style={`color:${accent};font-weight:800;flex-shrink:0;`}>✓</span> {f}
                </li>
              ))}
            </ul>
          </div>

          <div style="background:var(--color-primary);color:var(--color-white);padding:var(--space-4);border-radius:var(--radius-xl);margin-bottom:var(--space-4);text-align:center;">
            <p style="font-size:1.5rem;margin-bottom:var(--space-2);">💬</p>
            <h3 style="font-family:var(--font-heading);font-size:1.05rem;font-weight:800;margin-bottom:var(--space-1);">Discuss Your Project</h3>
            <p style="font-size:.85rem;opacity:.8;line-height:1.6;margin-bottom:var(--space-3);">Get a no-obligation proposal with transparent ZAR pricing within 24 hours.</p>
            <a href={`${base}contact/`} data-analytics-cta={`service-${solution.data.slug}-sidebar`} style={`display:block;text-align:center;background:${accent};color:var(--color-white);padding:12px 24px;border-radius:var(--radius-full);font-weight:700;text-decoration:none;font-size:.9rem;`}>Get a Free Quote →</a>
          </div>

          <a href="https://wa.me/27600000000?text=Hi%2C%20I%27d%20like%20to%20discuss%20a%20project%20with%20Mapengo%20Innovations." target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;gap:var(--space-2);background:#25D366;color:var(--color-white);padding:var(--space-2) var(--space-3);border-radius:var(--radius-lg);text-decoration:none;font-weight:600;font-size:.9rem;">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="22" height="22" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.125.555 4.122 1.528 5.857L.057 23.571l5.887-1.544A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.782 9.782 0 01-5.031-1.391l-.36-.214-3.734.979.996-3.648-.235-.374A9.79 9.79 0 012.18 12C2.18 6.58 6.58 2.18 12 2.18S21.818 6.58 21.818 12 17.42 21.818 12 21.818z"/></svg>
            Chat on WhatsApp
          </a>
        </aside>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section style="background:var(--color-grey-50);padding:var(--space-10) var(--space-4);text-align:center;">
      <div style="max-width:640px;margin:0 auto;">
        <h2 style="font-family:var(--font-heading);font-size:1.75rem;font-weight:800;color:var(--color-primary);margin-bottom:var(--space-2);">Your Business Could Be Our Next Success Story</h2>
        <p style="color:var(--color-grey-600);margin-bottom:var(--space-4);font-size:1rem;line-height:1.7;">Join 50+ South African businesses that have transformed their operations with Mapengo. Start with a free, no-obligation consultation.</p>
        <div style="display:flex;gap:var(--space-2);justify-content:center;flex-wrap:wrap;">
          <a href={`${base}contact/`} data-smart-cta data-analytics-cta={`service-${solution.data.slug}-bottom`} style="background:var(--color-accent);color:var(--color-white);padding:13px 32px;border-radius:var(--radius-full);font-weight:700;text-decoration:none;font-size:.95rem;">Start Your Project</a>
          <a href={`${base}services/`} style="border:2px solid var(--color-grey-200);color:var(--color-primary);padding:13px 32px;border-radius:var(--radius-full);font-weight:600;text-decoration:none;font-size:.95rem;">Explore All Services</a>
        </div>
      </div>
    </section>
  </main>

  <footer style="background:var(--color-primary);color:rgba(255,255,255,.7);padding:var(--space-6) var(--space-4);text-align:center;font-size:.9rem;">
    <p>&copy; {new Date().getFullYear()} Mapengo Innovations — <a href={`${base}legal/privacy/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Privacy</a> · <a href={`${base}legal/terms/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Terms</a></p>
  </footer>
</BaseLayout>

<style>
  .prose :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    padding-top: var(--space-5);
    border-top: 2px solid var(--color-grey-100);
  }
  .prose :global(h2:first-child) { border-top: none; padding-top: 0; margin-top: 0; }
  .prose :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
  }
  .prose :global(p) { line-height: 1.85; color: #374151; margin-bottom: var(--space-3); font-size: 1rem; }
  .prose :global(ul) { padding-left: var(--space-4); margin-bottom: var(--space-3); }
  .prose :global(li) { line-height: 1.75; color: #374151; margin-bottom: 6px; list-style: disc; }
  .prose :global(strong) { color: var(--color-primary); font-weight: 700; }
  .prose :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding: var(--space-3) var(--space-4);
    background: var(--color-grey-50);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-5) 0;
    font-style: italic;
    color: var(--color-grey-800);
  }
  @media (max-width: 768px) {
    .prose-grid { grid-template-columns: 1fr !important; }
  }
</style>
