---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---

<BaseLayout title="Privacy Policy" description="Privacy policy for Mapengo Innovations." noindex>
  <header style="background:var(--color-primary);color:var(--color-white);padding:var(--space-6) var(--space-4);">
    <nav style="max-width:var(--max-width);margin:0 auto;display:flex;justify-content:space-between;align-items:center;">
      <a href={base} style="font-family:var(--font-heading);font-size:1.5rem;font-weight:800;color:var(--color-white);text-decoration:none;">Mapengo<span style="color:var(--color-accent);">.</span></a>
      <a href={base} style="color:var(--color-accent);text-decoration:none;">← Home</a>
    </nav>
  </header>

  <main style="max-width:760px;margin:0 auto;padding:var(--space-10) var(--space-4);">
    <h1 style="font-family:var(--font-heading);font-size:2.5rem;font-weight:800;color:var(--color-primary);margin-bottom:var(--space-2);">Privacy Policy</h1>
    <p style="color:var(--color-grey-600);margin-bottom:var(--space-6);">Last updated: {new Date().toLocaleDateString('en-ZA', { year: 'numeric', month: 'long', day: 'numeric' })}</p>

    <section style="margin-bottom:var(--space-5);">
      <h2 style="font-family:var(--font-heading);font-size:1.5rem;font-weight:700;color:var(--color-primary);margin-bottom:var(--space-2);">1. Who We Are</h2>
      <p style="line-height:1.8;color:#374151;">Mapengo Innovations ("we", "us", "our") is a digital solutions company based in South Africa. We build websites, mobile apps, and cloud solutions for businesses. For privacy enquiries contact: <a href="mailto:hello@mapengoinnovations.co.za" style="color:var(--color-accent);">hello@mapengoinnovations.co.za</a></p>
    </section>

    <section style="margin-bottom:var(--space-5);">
      <h2 style="font-family:var(--font-heading);font-size:1.5rem;font-weight:700;color:var(--color-primary);margin-bottom:var(--space-2);">2. Information We Collect</h2>
      <p style="line-height:1.8;color:#374151;">We may collect personal information you voluntarily provide (name, email, company) via our contact form. We also collect anonymised usage analytics if you consent.</p>
    </section>

    <section style="margin-bottom:var(--space-5);">
      <h2 style="font-family:var(--font-heading);font-size:1.5rem;font-weight:700;color:var(--color-primary);margin-bottom:var(--space-2);">3. How We Use Your Information</h2>
      <p style="line-height:1.8;color:#374151;">Information you provide is used solely to respond to your enquiry, provide requested services, and improve our offerings. We do not sell or share your personal information with third parties.</p>
    </section>

    <section style="margin-bottom:var(--space-5);">
      <h2 style="font-family:var(--font-heading);font-size:1.5rem;font-weight:700;color:var(--color-primary);margin-bottom:var(--space-2);">4. POPIA Compliance</h2>
      <p style="line-height:1.8;color:#374151;">We comply with the Protection of Personal Information Act (POPIA) of South Africa. You have the right to access, correct, or request deletion of your personal data at any time by contacting us.</p>
    </section>

    <section style="margin-bottom:var(--space-5);">
      <h2 style="font-family:var(--font-heading);font-size:1.5rem;font-weight:700;color:var(--color-primary);margin-bottom:var(--space-2);">5. Cookies</h2>
      <p style="line-height:1.8;color:#374151;">We use local storage for analytics preferences you choose to set. No third-party cookies are used without your explicit consent.</p>
    </section>

    <section>
      <h2 style="font-family:var(--font-heading);font-size:1.5rem;font-weight:700;color:var(--color-primary);margin-bottom:var(--space-2);">6. Contact</h2>
      <p style="line-height:1.8;color:#374151;">For any privacy concerns or to exercise your rights, email <a href="mailto:hello@mapengoinnovations.co.za" style="color:var(--color-accent);">hello@mapengoinnovations.co.za</a>.</p>
    </section>
  </main>

  <footer style="background:var(--color-primary);color:rgba(255,255,255,.7);padding:var(--space-6) var(--space-4);text-align:center;font-size:.9rem;">
    <p>&copy; {new Date().getFullYear()} Mapengo Innovations — <a href={`${base}legal/terms/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Terms</a></p>
  </footer>
</BaseLayout>
