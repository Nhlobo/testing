---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---

<BaseLayout
  title="POPIA Compliance"
  description="Mapengo Innovations POPIA compliance statement — how we handle personal information in accordance with the Protection of Personal Information Act."
>
  <header style="background:var(--color-primary);color:var(--color-white);padding:var(--space-6) var(--space-4);">
    <nav style="max-width:var(--max-width);margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-2);">
      <a href={base} style="font-family:var(--font-heading);font-size:1.5rem;font-weight:800;color:var(--color-white);text-decoration:none;">Mapengo<span style="color:var(--color-accent);">.</span></a>
      <nav style="display:flex;gap:var(--space-3);">
        <a href={`${base}legal/privacy/`} style="color:rgba(255,255,255,.7);text-decoration:none;font-size:.9rem;">Privacy Policy</a>
        <a href={`${base}legal/terms/`} style="color:rgba(255,255,255,.7);text-decoration:none;font-size:.9rem;">Terms of Service</a>
        <a href={`${base}legal/popia/`} style="color:var(--color-accent);text-decoration:none;font-size:.9rem;font-weight:600;">POPIA</a>
      </nav>
    </nav>
  </header>

  <main>
    <section style="background:var(--color-primary);color:var(--color-white);padding:var(--space-10) var(--space-4);text-align:center;">
      <h1 style="font-family:var(--font-heading);font-size:2.5rem;font-weight:800;margin-bottom:var(--space-2);">POPIA Compliance</h1>
      <p style="opacity:.8;">Protection of Personal Information Act (Act 4 of 2013)</p>
      <p style="opacity:.6;font-size:.85rem;margin-top:8px;">Last updated: April 2026</p>
    </section>

    <section style="padding:var(--space-12) var(--space-4);">
      <div style="max-width:780px;margin:0 auto;" class="legal-content">
        <div style="background:#e8f5e9;border-left:4px solid var(--color-teal);padding:var(--space-3);border-radius:0 var(--radius-md) var(--radius-md) 0;margin-bottom:var(--space-5);">
          <p style="font-weight:700;color:#2e7d32;margin-bottom:4px;">🇿🇦 POPIA Compliant</p>
          <p style="color:#388e3c;font-size:.9rem;">Mapengo Innovations (Pty) Ltd is registered as a responsible party under POPIA and is committed to the lawful and transparent processing of personal information.</p>
        </div>

        <h2>1. Who We Are</h2>
        <p><strong>Responsible Party:</strong> Mapengo Innovations (Pty) Ltd<br/>
        <strong>Information Officer:</strong> Nhlovo Mathebula<br/>
        <strong>Registration:</strong> South African company<br/>
        <strong>Email:</strong> privacy@mapengo.co.za</p>

        <h2>2. Purpose of This Notice</h2>
        <p>This notice explains how Mapengo Innovations collects, uses, stores, and protects personal information in compliance with the Protection of Personal Information Act 4 of 2013 (POPIA).</p>

        <h2>3. Personal Information We Collect</h2>
        <p>We collect only the personal information necessary to provide our services:</p>
        <ul>
          <li><strong>Contact information:</strong> Name, email address, phone number, company name</li>
          <li><strong>Communication records:</strong> Messages sent through our contact form or email</li>
          <li><strong>Technical data:</strong> IP address, browser type, pages visited (with your consent)</li>
          <li><strong>Financial information:</strong> Billing details for contracted services (processed securely through certified payment processors)</li>
        </ul>

        <h2>4. Lawful Basis for Processing</h2>
        <p>We process personal information only when:</p>
        <ul>
          <li>You have given <strong>consent</strong> (e.g., contact form submissions, analytics cookies)</li>
          <li>Processing is necessary to <strong>fulfil a contract</strong> with you</li>
          <li>We have a <strong>legitimate interest</strong> that does not override your rights</li>
          <li>We are <strong>required by law</strong> to process the information</li>
        </ul>

        <h2>5. Your Rights Under POPIA</h2>
        <p>You have the following rights regarding your personal information:</p>
        <ul>
          <li><strong>Right to access:</strong> Request a copy of personal information we hold about you</li>
          <li><strong>Right to correction:</strong> Request correction of inaccurate or outdated information</li>
          <li><strong>Right to deletion:</strong> Request deletion of your personal information (subject to legal requirements)</li>
          <li><strong>Right to object:</strong> Object to processing of your personal information</li>
          <li><strong>Right to withdraw consent:</strong> Withdraw consent at any time where processing is consent-based</li>
          <li><strong>Right to complain:</strong> Lodge a complaint with the Information Regulator</li>
        </ul>
        <p>To exercise any of these rights, email us at <strong>privacy@mapengo.co.za</strong>. We will respond within 30 days.</p>

        <h2>6. Data Retention</h2>
        <p>We retain personal information only as long as necessary:</p>
        <ul>
          <li><strong>Contact enquiries:</strong> 2 years from last contact</li>
          <li><strong>Client project records:</strong> 5 years after project completion</li>
          <li><strong>Financial records:</strong> 5 years (SARS requirements)</li>
          <li><strong>Analytics data:</strong> 12 months (anonymised after 30 days)</li>
        </ul>

        <h2>7. Third-Party Sharing</h2>
        <p>We do not sell your personal information. We may share information with:</p>
        <ul>
          <li><strong>Service providers</strong> necessary to provide our services (e.g., payment processors, cloud hosting), under strict data processing agreements</li>
          <li><strong>Legal authorities</strong> when required by law</li>
        </ul>
        <p>All third-party processors are required to maintain equivalent levels of data protection.</p>

        <h2>8. Security Measures</h2>
        <p>We implement appropriate technical and organisational measures to protect personal information:</p>
        <ul>
          <li>All data transmitted via HTTPS/TLS encryption</li>
          <li>Access controls and authentication requirements</li>
          <li>Regular security assessments and updates</li>
          <li>Staff training on data protection</li>
          <li>Incident response procedures</li>
        </ul>

        <h2>9. Information Regulator</h2>
        <p>You have the right to lodge a complaint with the Information Regulator of South Africa if you believe your rights have been violated:</p>
        <p>
          <strong>The Information Regulator (South Africa)</strong><br/>
          Website: <a href="https://www.justice.gov.za/inforeg/" style="color:var(--color-accent);" rel="noopener noreferrer" target="_blank">www.justice.gov.za/inforeg</a><br/>
          Email: inforeg@justice.gov.za<br/>
          Tel: 012 406 4818
        </p>

        <h2>10. Contact Us</h2>
        <p>For any POPIA-related enquiries, contact our Information Officer:</p>
        <p>
          <strong>Nhlovo Mathebula</strong><br/>
          Mapengo Innovations (Pty) Ltd<br/>
          Email: privacy@mapengo.co.za
        </p>
      </div>
    </section>
  </main>

  <footer style="background:var(--color-primary);color:rgba(255,255,255,.7);padding:var(--space-6) var(--space-4);text-align:center;font-size:.9rem;">
    <div style="max-width:var(--max-width);margin:0 auto;display:flex;justify-content:center;gap:var(--space-3);flex-wrap:wrap;margin-bottom:var(--space-2);">
      <a href={`${base}legal/popia/`} style="color:var(--color-accent);text-decoration:none;">POPIA</a>
      <a href={`${base}legal/privacy/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Privacy Policy</a>
      <a href={`${base}legal/terms/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Terms of Service</a>
      <a href={base} style="color:rgba(255,255,255,.6);text-decoration:none;">Home</a>
    </div>
    <p>&copy; {new Date().getFullYear()} Mapengo Innovations</p>
  </footer>
</BaseLayout>

<style>
  .legal-content h2 { font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--color-primary); margin: var(--space-5) 0 var(--space-2); padding-bottom: 8px; border-bottom: 2px solid var(--color-grey-100); }
  .legal-content p { color: var(--color-grey-800); line-height: 1.75; margin-bottom: var(--space-2); }
  .legal-content ul { padding-left: var(--space-3); margin-bottom: var(--space-3); }
  .legal-content ul li { color: var(--color-grey-800); line-height: 1.7; margin-bottom: 8px; list-style: disc; }
  .legal-content strong { color: var(--color-primary); font-weight: 600; }
</style>
