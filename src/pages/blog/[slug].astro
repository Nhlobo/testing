---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
>
  <header style="background:var(--color-primary);color:var(--color-white);padding:var(--space-6) var(--space-4);">
    <nav style="max-width:var(--max-width);margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-2);">
      <a href={base} style="font-family:var(--font-heading);font-size:1.5rem;font-weight:800;color:var(--color-white);text-decoration:none;">Mapengo<span style="color:var(--color-accent);">.</span></a>
      <ul style="list-style:none;display:flex;gap:var(--space-3);margin:0;padding:0;flex-wrap:wrap;">
        <li><a href={`${base}services/`} style="color:var(--color-white);text-decoration:none;">Services</a></li>
        <li><a href={`${base}work/`} style="color:var(--color-white);text-decoration:none;">Work</a></li>
        <li><a href={`${base}blog/`} style="color:var(--color-accent);text-decoration:none;font-weight:600;">Blog</a></li>
        <li><a href={`${base}contact/`} style="background:var(--color-accent);color:var(--color-white);padding:8px 20px;border-radius:var(--radius-full);text-decoration:none;font-weight:600;">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section style="background:var(--color-primary);color:var(--color-white);padding:var(--space-10) var(--space-4);">
      <div style="max-width:760px;margin:0 auto;">
        <a href={`${base}blog/`} style="color:var(--color-accent);text-decoration:none;font-size:.9rem;">← Back to Blog</a>
        <div style="margin-top:var(--space-3);">
          <span style="display:inline-block;background:rgba(255,255,255,.15);font-size:.8rem;font-weight:600;padding:4px 12px;border-radius:var(--radius-full);margin-bottom:var(--space-2);">{post.data.category}</span>
          <h1 style="font-family:var(--font-heading);font-size:clamp(1.75rem,4vw,2.75rem);font-weight:800;line-height:1.2;margin-bottom:var(--space-2);">{post.data.title}</h1>
          <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;font-size:.9rem;opacity:.8;">
            <span>By {post.data.author}</span>
            <span>·</span>
            <time>{post.data.date.toLocaleDateString('en-ZA', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          </div>
        </div>
      </div>
    </section>

    <section style="padding:var(--space-10) var(--space-4);">
      <div style="max-width:760px;margin:0 auto;">
        <div class="prose">
          <Content />
        </div>
      </div>
    </section>
  </main>

  <footer style="background:var(--color-primary);color:rgba(255,255,255,.7);padding:var(--space-6) var(--space-4);text-align:center;font-size:.9rem;">
    <p>&copy; {new Date().getFullYear()} Mapengo Innovations — <a href={`${base}legal/privacy/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Privacy</a> · <a href={`${base}legal/terms/`} style="color:rgba(255,255,255,.6);text-decoration:none;">Terms</a></p>
  </footer>
</BaseLayout>

<style>
  .prose :global(h2), .prose :global(h3) {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-primary);
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
  }
  .prose :global(p) {
    line-height: 1.8;
    color: #374151;
    margin-bottom: var(--space-3);
  }
  .prose :global(ul), .prose :global(ol) {
    padding-left: var(--space-4);
    margin-bottom: var(--space-3);
  }
  .prose :global(li) {
    line-height: 1.7;
    color: #374151;
    margin-bottom: 4px;
  }
  .prose :global(strong) {
    color: var(--color-primary);
  }
  .prose :global(a) {
    color: var(--color-accent);
  }
</style>
