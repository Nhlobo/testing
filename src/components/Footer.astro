---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href={base} class="footer-logo">Mapengo<span>.</span></a>
      <p class="footer-tagline">South Africa's trusted digital partner for web, mobile, and business systems. Based in Johannesburg — serving nationwide.</p>
      <a
        href="https://wa.me/27600000000?text=Hi%2C%20I%27d%20like%20to%20discuss%20a%20project%20with%20Mapengo%20Innovations."
        target="_blank"
        rel="noopener noreferrer"
        class="footer-wa"
        aria-label="Chat on WhatsApp"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.125.555 4.122 1.528 5.857L.057 23.571l5.887-1.544A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.782 9.782 0 01-5.031-1.391l-.36-.214-3.734.979.996-3.648-.235-.374A9.79 9.79 0 012.18 12C2.18 6.58 6.58 2.18 12 2.18S21.818 6.58 21.818 12 17.42 21.818 12 21.818z"/>
        </svg>
        WhatsApp Us
      </a>
    </div>

    <div class="footer-nav">
      <div>
        <h4>Services</h4>
        <ul>
          <li><a href={`${base}services/web-development/`}>Web Development</a></li>
          <li><a href={`${base}services/mobile-apps/`}>Mobile Apps</a></li>
          <li><a href={`${base}services/ecommerce/`}>E-Commerce</a></li>
          <li><a href={`${base}services/ui-ux-design/`}>UI/UX Design</a></li>
          <li><a href={`${base}services/systems-integration/`}>Business Systems</a></li>
          <li><a href={`${base}services/cloud-hosting/`}>Cloud Hosting</a></li>
        </ul>
      </div>
      <div>
        <h4>Industries</h4>
        <ul>
          <li><a href={`${base}industries/sme-automation/`}>SME Automation</a></li>
          <li><a href={`${base}industries/retail-spaza/`}>Retail &amp; Spaza</a></li>
          <li><a href={`${base}industries/healthcare/`}>Healthcare</a></li>
          <li><a href={`${base}industries/education-schools/`}>Education</a></li>
          <li><a href={`${base}industries/taxi-transport/`}>Transport</a></li>
          <li><a href={`${base}industries/construction-property/`}>Construction</a></li>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href={`${base}about/`}>About Us</a></li>
          <li><a href={`${base}case-studies/`}>Case Studies</a></li>
          <li><a href={`${base}work/`}>Portfolio</a></li>
          <li><a href={`${base}pricing/`}>Pricing</a></li>
          <li><a href={`${base}process/`}>Our Process</a></li>
          <li><a href={`${base}blog/`}>Blog</a></li>
        </ul>
      </div>
      <div>
        <h4>Legal</h4>
        <ul>
          <li><a href={`${base}legal/privacy/`}>Privacy Policy</a></li>
          <li><a href={`${base}legal/terms/`}>Terms of Service</a></li>
          <li><a href={`${base}legal/popia/`}>POPIA Compliance</a></li>
          <li><a href={`${base}contact/`}>Contact Us</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} Mapengo Innovations (Pty) Ltd. All rights reserved. Registered in South Africa.</p>
    <p class="footer-popia">🔒 POPIA compliant &nbsp;·&nbsp; Secure by design &nbsp;·&nbsp; Johannesburg, South Africa</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: rgba(255,255,255,.7);
    padding-top: var(--space-10);
  }
  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-8);
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: var(--space-8);
  }
  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-white);
    text-decoration: none;
    display: block;
    margin-bottom: var(--space-2);
  }
  .footer-logo span { color: var(--color-accent); }
  .footer-tagline {
    font-size: .9rem;
    line-height: 1.7;
    color: rgba(255,255,255,.65);
    margin-bottom: var(--space-3);
    max-width: 320px;
  }
  .footer-wa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #25D366;
    color: var(--color-white);
    padding: 9px 20px;
    border-radius: var(--radius-full);
    font-size: .875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background var(--transition);
  }
  .footer-wa:hover { background: #1da851; }
  .footer-nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }
  .footer-nav h4 {
    font-family: var(--font-heading);
    font-size: .8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--color-white);
    margin-bottom: var(--space-2);
  }
  .footer-nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .footer-nav a {
    color: rgba(255,255,255,.6);
    text-decoration: none;
    font-size: .875rem;
    transition: color var(--transition);
  }
  .footer-nav a:hover { color: var(--color-accent); }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,.1);
    padding: var(--space-3) var(--space-4);
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: .8125rem;
  }
  .footer-popia { color: rgba(255,255,255,.4); }

  @media (max-width: 1024px) {
    .footer-nav { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .footer-inner { grid-template-columns: 1fr; gap: var(--space-5); }
    .footer-nav { grid-template-columns: repeat(2, 1fr); }
    .footer-bottom { flex-direction: column; text-align: center; }
  }
  @media (max-width: 480px) {
    .footer-nav { grid-template-columns: 1fr 1fr; }
  }
</style>
